            </Grid>
        </Border>

        <!-- ================= TOP BAR FOCUS TIMER DROPDOWN POPOVER ================= -->
        <Grid x:Name="TopBarTimerDropdownGrid" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="340">
