                                                        <CombinedGeometry.Geometry2>
                                                            <EllipseGeometry Center="15.0,8.8" RadiusX="6.4" RadiusY="6.4"/>
                                                        </CombinedGeometry.Geometry2>
                                                    </CombinedGeometry>
                                                </Path.Data>
                                            </Path>
                                            <Path Fill="#FBBF24" Data="M 17.5,3.2 L 18.2,5.3 L 20.3,6.0 L 18.2,6.7 L 17.5,8.8 L 16.8,6.7 L 14.7,6.0 L 16.8,5.3 Z"/>
                                        </Canvas>
                                    </Grid>
                                </Viewbox>
                                <TextBlock x:Name="TxtPdfDarkLabel" Text="Dark Mode" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Split with Notes -->
                        <Button Click="BtnPdfSplitWithNotes_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◫ " FontSize="12"/>
                                <TextBlock Text="Split with Notes" FontSize="12" FontWeight="Bold" Foreground="#A78BFA"/>
                            </StackPanel>
                        </Button>

                        <!-- Open in External OS Viewer -->
                        <Button Click="BtnPdfOpenExternal_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="12,6" ToolTip="Open in System Default App (Adobe / Edge / Chrome)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↗ " FontSize="12"/>
                                <TextBlock Text="External" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Download File -->
                        <Button Click="BtnPdfDownload_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="10,6" ToolTip="Save Copy to PC">
                            <TextBlock Text="⤓" FontSize="13" FontWeight="Bold"/>
                        </Button>

                        <!-- Close PDF Viewer (Esc) -->
                        <Button Click="BtnClosePdfViewer_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" ToolTip="Close Viewer">
                            <TextBlock Text="✕" FontSize="13" FontWeight="Bold" Foreground="#F43F5E"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- PDF Content Area -->
            <Grid Grid.Row="1" Background="#060814">
                <wv2:WebView2 x:Name="PdfWebView" DefaultBackgroundColor="#060814"/>

                <!-- Loading Spinner Indicator -->
                <Border x:Name="BdPdfLoader" Background="#DD060814" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⌛" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="Rendering PDF Document..." FontWeight="Bold" FontSize="14" Foreground="#22D3EE" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= RETRACTABLE APP NAVIGATION DRAWER ================= -->
        <Grid x:Name="AppNavigationDrawerGrid" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="360">
            <!-- Semi-transparent backdrop -->
            <Border Background="#99000000" MouseDown="NavDrawerBackdrop_MouseDown"/>
            <!-- Slide Drawer Panel (Left-aligned) -->
            <Border x:Name="BdNavDrawerPanel" Width="340" HorizontalAlignment="Left" Background="#0E1225" BorderBrush="#20274A" BorderThickness="0,0,1,0" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Drawer Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="38" Height="38" CornerRadius="12" Margin="0,0,10,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#7C5CFF" Offset="0.0"/>
                                        <GradientStop Color="#A855F7" Offset="0.5"/>
                                        <GradientStop Color="#22D3EE" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="🎓" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="StudyHub" FontSize="18" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="Navigation Hub" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Click="BtnCloseNavDrawer_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="8,4">
                            <TextBlock Text="✕" FontSize="12"/>
                        </Button>
                    </Grid>

                    <!-- Navigation Items List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- 1. My Subjects -->
                            <Button Click="BtnDrawerSubjects_Click" Style="{StaticResource SettingsTabButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📖" FontSize="14" Margin="0,0,12,0"/>
                                    <TextBlock Text="My Subjects" FontSize="13.5"/>
                                </StackPanel>
                            </Button>

                            <!-- 1b. Calendar & Upcoming Events -->
                            <Button Click="BtnDrawerCalendar_Click" Style="{StaticResource SettingsTabButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📅" FontSize="14" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="TxtDrawerCalendarLabel" Text="Calendar &amp; Upcoming Events" FontSize="13.5"/>
                                </StackPanel>
                            </Button>

                            <!-- 2. Focus Timer -->
                            <Button Click="BtnDrawerTimer_Click" Style="{StaticResource SettingsTabButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⏱️" FontSize="14" Margin="0,0,12,0"/>
                                    <TextBlock Text="Focus Timer" FontSize="13.5"/>
                                </StackPanel>
                            </Button>

                            <!-- 3. Zen Study Mode -->
                            <Button Click="BtnDrawerZen_Click" Style="{StaticResource SettingsTabButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🧘" FontSize="14" Margin="0,0,12,0"/>
                                    <TextBlock Text="Zen Study Mode" FontSize="13.5"/>
                                </StackPanel>
                            </Button>

                            <!-- 4. Sound Mixer -->
                            <Button Click="BtnDrawerMixer_Click" Style="{StaticResource SettingsTabButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎚️" FontSize="14" Margin="0,0,12,0"/>
                                    <TextBlock Text="Sound Studio &amp; Mixer" FontSize="13.5"/>
                                </StackPanel>
                            </Button>

                            <!-- 5. Theme Toggle -->
                            <Button Click="BtnDrawerTheme_Click" Style="{StaticResource SettingsTabButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌙" FontSize="14" Margin="0,0,12,0"/>
                                    <TextBlock Text="Toggle Theme" FontSize="13.5"/>
                                </StackPanel>
                            </Button>

                            <!-- 6. Settings & GitHub Auto-Updater -->
                            <Button Click="BtnDrawerSettings_Click" Style="{StaticResource SettingsTabButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙️" FontSize="14" Margin="0,0,12,0"/>
                                    <TextBlock Text="Settings &amp; Preferences" FontSize="13.5"/>
                                </StackPanel>
                            </Button>

                            <Border Height="1" Background="{DynamicResource BorderBrushTheme}" Margin="0,12,0,12"/>

                            <!-- 7. Add Subject Quick Action -->
                            <Button Click="BtnDrawerAddSubject_Click" Style="{StaticResource BrandButtonStyle}" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="➕" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Add Subject" FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <!-- 8. Archived Courses Collapsible Section in Navigation Drawer -->
                            <Border Background="{DynamicResource SubtleBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="14" Padding="12,10">
                                <StackPanel>
                                    <Button Click="BtnToggleDrawerArchived_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Stretch">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📦" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Archived Courses" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtDrawerArchivedBadge" Text="(0)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtDrawerArchivedChevron" Text="▼" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                    <StackPanel x:Name="DrawerArchivedStackPanel" Margin="0,10,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Drawer Footer -->
                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <TextBlock Text="Study Hub v3.0 • Remastered Edition" FontSize="11" Foreground="#687296"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= FLOATING / SLIDE-OUT AMBIENT SOUND STUDIO MIXER ================= -->
        <Grid x:Name="SoundMixerDrawerGrid" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="350">
            <!-- Clickable backdrop -->
            <Border Background="#66000000" MouseDown="SoundMixerBackdrop_MouseDown"/>

            <!-- Floating Sound Mixer Card (Top-Right Drawer matching Reference Design) -->
            <Border x:Name="BdSoundMixerPanel"
                    Width="405"
                    MaxHeight="670"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,72,20,24"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderBrushTheme}"
                    BorderThickness="1"
                    CornerRadius="24"
                    ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="35" ShadowDepth="10" Opacity="0.45"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- 0. Header -->
                        <RowDefinition Height="Auto"/> <!-- 1. Master Controls & Presets -->
                        <RowDefinition Height="*"/>    <!-- 2. Multi-Channel Scrollable List -->
                        <RowDefinition Height="Auto"/> <!-- 3. Footer -->
                    </Grid.RowDefinitions>

                    <!-- 0. Mixer Header -->
                    <Border x:Name="BdSoundMixerHeader" Grid.Row="0" Padding="18,14" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="0,0,0,1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#1F7C5CFF" Offset="0.0"/>
                                <GradientStop Color="#14A855F7" Offset="0.5"/>
                                <GradientStop Color="#1F22D3EE" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Gradient Icon Box -->
                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="12" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#7C5CFF" Offset="0.0"/>
                                        <GradientStop Color="#22D3EE" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="🎚️" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Title + Active Count Badge + Subtitle -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtSoundMixerHeader" Text="Ambient Sound Mixer" FontWeight="Black" FontSize="15.5" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                    <Border x:Name="BdMixerActiveBadge" Background="#7C5CFF" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock x:Name="TxtMixerActiveBadge" Text="0 active" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Seamless studio ambient &amp; white noise" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Close X Button -->
                            <Button Grid.Column="2" Click="BtnCloseSoundMixer_Click" Width="32" Height="32" Style="{StaticResource SecondaryButtonStyle}" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Close Sound Mixer">
                                <TextBlock Text="✕" FontSize="12" FontWeight="Bold"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 1. Master Controls, Volume Slider & Quick Presets -->
                    <Border x:Name="BdSoundMixerMasterCard" Grid.Row="1" Background="{DynamicResource SubtleBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="0,0,0,1" Padding="16,14">
                        <StackPanel>
                            <!-- Transport Buttons + Master Volume -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Green Play / Orange Pause Button (Crisp Vector Icons) -->
                                <Button x:Name="BtnMasterAudioPlay" Grid.Column="0" Click="BtnMasterAudioPlay_Click" Width="38" Height="38" Cursor="Hand" BorderThickness="0" Background="#10B981" Margin="0,0,8,0" ToolTip="Play / Pause All Ambience">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path x:Name="IconMasterPlayTriangle" Data="M 3,1.5 L 12.5,7 L 3,12.5 Z" Fill="White" Visibility="Visible"/>
                                        <StackPanel x:Name="IconMasterPauseBars" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                            <Border Width="3.5" Height="12.5" CornerRadius="1.2" Background="White" Margin="0,0,3.5,0"/>
                                            <Border Width="3.5" Height="12.5" CornerRadius="1.2" Background="White"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Stop & Reset Button -->
                                <Button x:Name="BtnMasterAudioStop" Grid.Column="1" Click="BtnMasterAudioReset_Click" Width="38" Height="38" Style="{StaticResource SecondaryButtonStyle}" Padding="0" Margin="0,0,8,0" ToolTip="Stop &amp; Reset All Ambience">
                                    <Border Width="11" Height="11" CornerRadius="2.2" Background="{DynamicResource PrimaryTextBrush}"/>
                                </Button>

                                <!-- Purple Mute Toggle Button -->
                                <Button x:Name="BtnMasterAudioMute" Grid.Column="2" Click="BtnMasterAudioMute_Click" Width="38" Height="38" Cursor="Hand" BorderThickness="0" Background="#7C5CFF" Margin="0,0,12,0" ToolTip="Toggle Master Mute">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock x:Name="TxtMasterMuteIcon" Text="🔊" FontSize="14" Foreground="White"/>
                                </Button>

                                <!-- Master Label & Slider -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <Grid Margin="0,0,0,2">
                                        <TextBlock Text="Master" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtMasterVolLabel" Text="80%" FontWeight="Bold" FontSize="12" FontFamily="Consolas, Courier New" Foreground="#A78BFA" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Slider x:Name="SliderMasterVolume" Minimum="0" Maximum="100" Value="80" Style="{StaticResource StudioSliderStyle}" ValueChanged="SliderMasterVolume_ValueChanged"/>
                                </StackPanel>
                            </Grid>

                            <!-- Quick Mix Presets Row (Horizontal Scroll, clean mousewheel strip matching reference) -->
                            <ScrollViewer x:Name="MixerPresetsScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="MixerPresetsScrollViewer_PreviewMouseWheel">
                                <StackPanel Orientation="Horizontal">
                                    <!-- + Save Mix -->
                                    <Button Click="BtnSaveSoundPreset_Click" Cursor="Hand" Foreground="#7C5CFF" Margin="0,0,6,0" ToolTip="Save Current Mix as Custom Preset">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="#227C5CFF" BorderBrush="#667C5CFF" BorderThickness="1" CornerRadius="9" Padding="10,5">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#7C5CFF"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="+ Save Mix" FontSize="11" FontWeight="Bold"/>
                                    </Button>

                                    <!-- Custom Saved Presets List -->
                                    <StackPanel x:Name="MixerCustomPresetsStackPanel" Orientation="Horizontal"/>

                                    <!-- Built-in Quick Presets -->
                                    <Button Click="BtnSoundPreset_Click" Tag="rainy_zen" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" Margin="0,0,6,0">
                                        <TextBlock Text="🌧️ Rainy Study" FontSize="11" FontWeight="Bold"/>
                                    </Button>
                                    <Button Click="BtnSoundPreset_Click" Tag="cozy_hearth" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" Margin="0,0,6,0">
                                        <TextBlock Text="🔥 Cozy Campfire" FontSize="11" FontWeight="Bold"/>
                                    </Button>
                                    <Button Click="BtnSoundPreset_Click" Tag="sanctuary" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" Margin="0,0,6,0">
                                        <TextBlock Text="🌸 Zen Garden" FontSize="11" FontWeight="Bold"/>
                                    </Button>
                                    <Button Click="BtnSoundPreset_Click" Tag="deep_brown" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5">
                                        <TextBlock Text="🎧 Deep Brown" FontSize="11" FontWeight="Bold"/>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- 2. Multi-Channel Ambient Track Sliders List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,12,10,12">
                        <StackPanel x:Name="MixerChannelsStackPanel"/>
                    </ScrollViewer>

                    <!-- 3. Footer: Zero-fade caption & + Import Sounds -->
                    <Border x:Name="BdSoundMixerFooter" Grid.Row="3" Background="{DynamicResource SubtleBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="0,1,0,0" Padding="16,10">
                        <Grid>
                            <TextBlock Text="Zero-fade continuous audio loops" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                            <Button Click="BtnUploadCustomSound_Click" HorizontalAlignment="Right" Cursor="Hand" Foreground="#7C5CFF" ToolTip="Import custom .mp3, .wav, or .ogg audio loops">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#227C5CFF" BorderBrush="#447C5CFF" BorderThickness="1" CornerRadius="10" Padding="12,6">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#7C5CFF"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="+ Import Sounds" FontSize="11.5" FontWeight="Bold"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= FULLSCREEN ZEN STUDY MODE OVERLAY ================= -->
        <Grid x:Name="ZenModeOverlayGrid" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="300" Background="#060814" Focusable="True" KeyDown="ZenModeOverlayGrid_KeyDown">
            <!-- 1. Native High-Performance Animated Scene Canvas (All 17 Built-in Worlds + Minimalist None) -->
            <controls:ZenSceneCanvas x:Name="ZenSceneRenderer" Panel.ZIndex="1" ClipToBounds="True"/>

            <!-- 2. Custom Local Video / Image Loop Layer -->
            <MediaElement x:Name="ZenCustomVideoPlayer" Panel.ZIndex="2" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="UniformToFill" Visibility="Collapsed" MediaEnded="ZenCustomVideoPlayer_MediaEnded" MediaFailed="ZenCustomVideoPlayer_MediaFailed"/>
            <Image x:Name="ZenCustomImageView" Panel.ZIndex="2" Stretch="UniformToFill" Visibility="Collapsed"/>

            <!-- 3. Subtle Atmospheric Vignette -->
            <Border Panel.ZIndex="3" IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.72" RadiusY="0.72">
                        <GradientStop Color="#00040610" Offset="0.48"/>
                        <GradientStop Color="#8C040610" Offset="1.0"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- 4. Top Center Zen HUD Capsule (Digital or Analog Clock, Timer Readout & Separate Scene Pill) -->
            <StackPanel x:Name="ZenCenterOverlay" Panel.ZIndex="10" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,34,0,0">
                <!-- Clock & Focus Timer Card -->
                <Border x:Name="ZenTopHud" HorizontalAlignment="Center" Background="#66000000" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="24" Padding="32,16" Margin="0,0,0,12">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="8" Opacity="0.45"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Digital Clock Display -->
                        <StackPanel x:Name="ZenDigitalClockWrap" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtZenClockTime" Text="08:15" FontSize="54" FontWeight="Black" FontFamily="Consolas, Courier New" Foreground="White" VerticalAlignment="Bottom"/>
                            <TextBlock x:Name="TxtZenClockAmPm" Text="PM" FontSize="17" FontWeight="Black" FontFamily="Consolas, Courier New" Foreground="#38BDF8" VerticalAlignment="Bottom" Margin="8,0,0,8"/>
                        </StackPanel>

                        <!-- Analog Clock Display (Shown when ClockStyle == "analog") -->
                        <StackPanel x:Name="ZenAnalogClockWrap" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox Width="126" Height="126">
                                <Canvas Width="120" Height="120">
                                    <Ellipse Width="108" Height="108" Canvas.Left="6" Canvas.Top="6" Fill="#880F172A" Stroke="#38FFFFFF" StrokeThickness="3"/>
                                    <!-- 12 Hour Markers -->
                                    <Line X1="60" Y1="10" X2="60" Y2="16" Stroke="#8CFFFFFF" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="85" Y1="16.7" X2="82" Y2="21.9" Stroke="#8CFFFFFF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="103.3" Y1="35" X2="98.1" Y2="38" Stroke="#8CFFFFFF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="110" Y1="60" X2="104" Y2="60" Stroke="#8CFFFFFF" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="103.3" Y1="85" X2="98.1" Y2="82" Stroke="#8CFFFFFF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="85" Y1="103.3" X2="82" Y2="98.1" Stroke="#8CFFFFFF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="60" Y1="110" X2="60" Y2="104" Stroke="#8CFFFFFF" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="35" Y1="103.3" X2="38" Y2="98.1" Stroke="#8CFFFFFF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="16.7" Y1="85" X2="21.9" Y2="82" Stroke="#8CFFFFFF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="10" Y1="60" X2="16" Y2="60" Stroke="#8CFFFFFF" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="16.7" Y1="35" X2="21.9" Y2="38" Stroke="#8CFFFFFF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="35" Y1="16.7" X2="38" Y2="21.9" Stroke="#8CFFFFFF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <!-- Hour Hand -->
                                    <Line X1="60" Y1="60" X2="60" Y2="32" Stroke="#FFFFFF" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        <Line.RenderTransform>
                                            <RotateTransform x:Name="ZenAnalogHourRotate" Angle="0" CenterX="60" CenterY="60"/>
                                        </Line.RenderTransform>
                                    </Line>
                                    <!-- Minute Hand -->
                                    <Line X1="60" Y1="60" X2="60" Y2="20" Stroke="#38BDF8" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        <Line.RenderTransform>
                                            <RotateTransform x:Name="ZenAnalogMinuteRotate" Angle="0" CenterX="60" CenterY="60"/>
                                        </Line.RenderTransform>
                                    </Line>
                                    <!-- Second Hand -->
                                    <Line X1="60" Y1="66" X2="60" Y2="16" Stroke="#F472B6" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        <Line.RenderTransform>
                                            <RotateTransform x:Name="ZenAnalogSecondRotate" Angle="0" CenterX="60" CenterY="60"/>
                                        </Line.RenderTransform>
                                    </Line>
                                    <Ellipse Width="8" Height="8" Canvas.Left="56" Canvas.Top="56" Fill="#F472B6"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="TxtZenAnalogSubText" Text="08:15 PM" FontFamily="Consolas, Courier New" FontSize="12" FontWeight="Bold" Foreground="#BAE6FD" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Divider line -->
                        <Border Height="1" Background="#1FFFFFFF" MinWidth="210" Margin="0,10,0,8"/>

                        <!-- Live Focus Timer Readout -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 10,2 L 14,2" Stroke="#FB7185" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Path Data="M 12,2 L 12,5" Stroke="#FB7185" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Ellipse Width="15" Height="15" Canvas.Left="4.5" Canvas.Top="5.5" Fill="#FB7185"/>
                                    <Path Data="M 12,13 L 15,9.5" Stroke="White" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="TxtZenTimerDisplay" Text="Focus Timer • 25:00" FontFamily="Consolas, Courier New" FontWeight="Bold" FontSize="12" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Custom Video Folder Prompt (Shown only when 'Custom Video' is active with no videos found) -->
                <Border x:Name="ZenCustomPromptBox" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,0,0,12" Background="#8C000000" BorderBrush="#55F59E0B" BorderThickness="1" CornerRadius="16" Padding="16,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 2,6 A 2,2 0 0,1 4,4 L 9,4 L 11,6 L 20,6 A 2,2 0 0,1 22,8 L 22,18 A 2,2 0 0,1 20,20 L 4,20 A 2,2 0 0,1 2,18 Z" Fill="#FBBF24" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="No custom videos found in folder." FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        <Button Click="BtnBrowseZenVideoFolder_Click" Style="{StaticResource BrandButtonStyle}" Padding="12,6" Margin="12,0,0,0">
                            <TextBlock Text="Select Video Folder" FontSize="11.5" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Active Scene Pill Badge Below Card -->
                <Border HorizontalAlignment="Center" Background="#73000000" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="16" Padding="16,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="#34D399" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtZenSceneLabel" Text="Northern Lights • North Pole &amp; Ice Mountains" FontSize="11.5" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 5. Top-Right Zen Floating Action Controls Bar -->
            <StackPanel x:Name="ZenTopBar" Panel.ZIndex="15" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,18,0" Orientation="Horizontal">
                <!-- Previous / Next / Pick Folder for Custom Video mode -->
                <Button x:Name="BtnZenPrevVideo" Visibility="Collapsed" Click="BtnZenPrevVideo_Click" Width="36" Height="36" Margin="0,0,8,0" Cursor="Hand" ToolTip="Previous Custom Video">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#D9111827" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="11">
                                <Path Data="M 6,5 L 6,19 M 18,5 L 8,12 L 18,19 Z" Fill="White" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E61F2937"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#55FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="BtnZenNextVideo" Visibility="Collapsed" Click="BtnZenNextVideo_Click" Width="36" Height="36" Margin="0,0,8,0" Cursor="Hand" ToolTip="Next Custom Video">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#D9111827" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="11">
                                <Path Data="M 18,5 L 18,19 M 6,5 L 16,12 L 6,19 Z" Fill="White" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E61F2937"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#55FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="BtnZenPickVideoFolder" Visibility="Collapsed" Click="BtnBrowseZenVideoFolder_Click" Width="36" Height="36" Margin="0,0,8,0" Cursor="Hand" ToolTip="Choose Local Video Folder">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#D9111827" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="11">
                                <Path Data="M 2,6 A 2,2 0 0,1 4,4 L 9,4 L 11,6 L 20,6 A 2,2 0 0,1 22,8 L 22,18 A 2,2 0 0,1 20,20 L 4,20 A 2,2 0 0,1 2,18 Z" Fill="#FBBF24" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E61F2937"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#55FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Custom Frosted Dark Zen Scene Dropdown Pill Button -->
                <Button x:Name="BtnZenSceneDropdown" Click="BtnZenSceneDropdown_Click" Height="36" Margin="0,0,10,0" Cursor="Hand" ToolTip="Choose Zen Mode Environment">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#D9111827" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="11" Padding="13,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E81F2937"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#48FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path x:Name="ZenDropdownBtnIconPath" Data="M 2,19 L 8.5,8 L 13,14 L 16.5,9.5 L 22,19 Z M 19,3.5 L 19.7,5.3 L 21.5,6 L 19.7,6.7 L 19,8.5 L 18.3,6.7 L 16.5,6 L 18.3,5.3 Z" Fill="#FBBF24" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtZenDropdownName" Text="Northern Lights" FontSize="12" FontWeight="Bold" Foreground="#FCD34D" VerticalAlignment="Center"/>
                        <Path x:Name="ZenDropdownChevron" Data="M 1,2 L 5,6 L 9,2" Stroke="#B8FFFFFF" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="6" Stretch="Uniform" Margin="8,1,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Show Study View Toggle -->
                <Button x:Name="BtnZenToggleStudyView" Click="BtnZenToggleStudyView_Click" Height="36" Margin="0,0,10,0" Cursor="Hand" ToolTip="Show/Hide Study Material Over Backdrop">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#CC111827" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="11" Padding="13,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E61F2937"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#48FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 4,4 C 7,4 10,5 12,6.5 C 14,5 17,4 20,4 L 21,4 L 21,18 L 20,18 C 17,18 14,19 12,20.5 C 10,19 7,18 4,18 L 3,18 L 3,4 Z" Fill="#67E8F9" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtZenStudyViewBtn" Text="Show Study View" FontSize="12" FontWeight="Bold" Foreground="#67E8F9" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Sound Mixer Button -->
                <Button Click="BtnZenToggleMixer_Click" Height="36" Margin="0,0,10,0" Cursor="Hand" ToolTip="Ambient Sound Studio &amp; Mixer (Ctrl+M)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#7C3AED" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="11" Padding="14,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 3,6 L 21,6 M 3,12 L 21,12 M 3,18 L 21,18 M 7,3.5 L 7,8.5 M 15,9.5 L 15,14.5 M 10,15.5 L 10,20.5" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Sound Mixer" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#8B5CF6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Exit Zen Button -->
                <Button Click="BtnExitZen_Click" Height="36" Cursor="Hand" ToolTip="Exit Zen Study Mode (Esc / F10)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#D9111827" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="11" Padding="14,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 4,9 L 9,9 L 9,4 M 20,9 L 15,9 L 15,4 M 4,15 L 9,15 L 9,20 M 20,15 L 15,15 L 15,20" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Exit Zen" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E11D48"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#55FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- 6. Custom Dark Frosted Zen Scene Dropdown Popover Overlay -->
            <Grid x:Name="ZenSceneDropdownOverlay" Panel.ZIndex="20" Visibility="Collapsed">
                <Border Background="#01000000" MouseDown="ZenSceneDropdownBackdrop_MouseDown"/>
                <Border x:Name="BdZenSceneDropdownMenu" Width="282" MaxHeight="400" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#F20F172A" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="16" Padding="8">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="36" ShadowDepth="10" Opacity="0.65"/>
                    </Border.Effect>
                    <ScrollViewer x:Name="ZenDropdownScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
                        <StackPanel x:Name="SpZenDropdownItems"/>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- 7. Optional Study View Translucent Card inside Zen Mode -->
            <Border x:Name="ZenStudyOverlayCard" Panel.ZIndex="30" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="32,128,32,32" Background="#DD0E1225" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="24" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock x:Name="TxtZenStudyCourseTitle" Text="Study View Overlay" FontSize="18" FontWeight="Black" Foreground="#22D3EE" VerticalAlignment="Center"/>
                        <Button Click="BtnCloseZenStudyCard_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="8,4">
                            <TextBlock Text="✕ Close Overlay" FontSize="11"/>
                        </Button>
                    </Grid>
                    <TextBox x:Name="TxtZenStudyNotes" Grid.Row="1" Style="{StaticResource ModernTextBoxStyle}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="14"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= CONTROL CENTER / SETTINGS MODAL DIALOG ================= -->
        <Grid x:Name="SettingsModalGrid" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="350">
            <!-- Semi-transparent backdrop -->
            <Border Background="#B3000000" MouseDown="SettingsBackdrop_MouseDown"/>

            <!-- 2-Column Dialog Container matching User Screenshots -->
            <Border Width="940" Height="640" MaxHeight="680" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource NavBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="24" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/> <!-- Sidebar Navigation -->
                        <ColumnDefinition Width="*"/>   <!-- Partitions Content Area -->
                    </Grid.ColumnDefinitions>

                    <!-- Left Sidebar (250px) -->
                    <Border Grid.Column="0" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="0,0,1,0" Padding="18,22">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Title Header -->
                                <RowDefinition Height="Auto"/> <!-- Divider -->
                                <RowDefinition Height="*"/>    <!-- Tabs Stack -->
                                <RowDefinition Height="Auto"/> <!-- Footer Info -->
                            </Grid.RowDefinitions>

                            <!-- Sidebar Header -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,16">
                                <Border Width="40" Height="40" CornerRadius="12" Margin="0,0,12,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#7C5CFF" Offset="0.0"/>
                                            <GradientStop Color="#22D3EE" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="🎛️" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Control Center" FontSize="16" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock Text="Settings &amp; Preferences" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrushTheme}" Margin="0,0,0,16"/>

                            <!-- Sidebar Tabs -->
                            <StackPanel Grid.Row="2">
                                <Button x:Name="BtnTabStorage" Click="BtnTabStorage_Click" Style="{StaticResource SettingsTabButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📁" FontSize="14" Margin="0,0,10,0"/>
                                        <TextBlock Text="File Storage &amp; Paths" FontSize="13" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnTabAudio" Click="BtnTabAudio_Click" Style="{StaticResource SettingsTabButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🎵" FontSize="14" Margin="0,0,10,0"/>
                                        <TextBlock Text="Audio &amp; Sound" FontSize="13" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnTabDisplay" Click="BtnTabDisplay_Click" Style="{StaticResource SettingsTabButtonActiveStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🎨" FontSize="14" Margin="0,0,10,0"/>
                                        <TextBlock Text="Interface &amp; Display" FontSize="13" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnTabData" Click="BtnTabData_Click" Style="{StaticResource SettingsTabButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💾" FontSize="14" Margin="0,0,10,0"/>
                                        <TextBlock Text="Data Management" FontSize="13" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnTabSystem" Click="BtnTabSystem_Click" Style="{StaticResource SettingsTabButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚙️" FontSize="14" Margin="0,0,10,0"/>
                                        <TextBlock Text="System Utilities" FontSize="13" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Sidebar Footer -->
                            <StackPanel Grid.Row="3" Margin="4,0,0,4">
                                <TextBlock Text="Study Hub v3.0 • Remastered Edition" FontSize="10.5" FontWeight="Bold" Foreground="#687296"/>
                                <TextBlock Text="All preferences auto-save" FontSize="10" Foreground="#4B5578" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Right Partition Content Area -->
                    <Grid Grid.Column="1" Margin="24,20,24,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Partition Header Bar -->
                            <RowDefinition Height="*"/>    <!-- Scrollable Content -->
                        </Grid.RowDefinitions>

                        <!-- Partition Top Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock x:Name="TxtSettingsHeaderTitle" Text="Interface &amp; Display" FontSize="19" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                            <Button Click="BtnCloseSettings_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="10,6">
                                <TextBlock Text="✕" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </Button>
                        </Grid>

                        <!-- Scrollable Content Partitions -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                            <StackPanel>
                                <!-- ================= PARTITION 1: INTERFACE & DISPLAY ================= -->
                                <StackPanel x:Name="SpartDisplay" Visibility="Visible">
                                    <!-- 1. Static Color & Surface Theme -->
                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,0,18">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="🎨" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Static Color &amp; Surface Theme" FontWeight="Black" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Choose the static color gradient &amp; glass surface style across the workspace." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,14"/>
                                            <!-- Theme Cards Grid (5 Themes) -->
                                            <UniformGrid x:Name="WpThemeCards" Columns="5"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 2. Animated Background Particle Effects -->
                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,0,18">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="✨" FontSize="14" Foreground="#06B6D4" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Animated Background Particle Effects" FontWeight="Black" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Border Background="#22D3EE22" BorderBrush="#22D3EE55" BorderThickness="1" CornerRadius="12" Padding="10,3" HorizontalAlignment="Right">
                                                    <TextBlock x:Name="TxtActiveParticleBadge" Text="Network Mesh" FontSize="11" FontWeight="Bold" Foreground="#06B6D4"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="Combine any static color theme above with a live interactive particle layer (including Lava Lamp, Fading Stars &amp; Water Ripple, or disable particles)." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                            <!-- Particle Cards Grid (9 Effects) -->
                                            <UniformGrid x:Name="WpParticleCards" Columns="3"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 3. Zen Mode Backdrop Scene -->
                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,0,18">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🧘" FontSize="14" Foreground="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Zen Mode Backdrop Scene" FontWeight="Black" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Border Background="#F59E0B22" BorderBrush="#F59E0B55" BorderThickness="1" CornerRadius="12" Padding="10,3" HorizontalAlignment="Right">
                                                    <TextBlock x:Name="TxtActiveZenSceneBadge" Text="Northern Lights" FontSize="11" FontWeight="Bold" Foreground="#F59E0B"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="Choose your active Zen Mode environment (or switch anytime from the compact dropdown inside Zen Mode)." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                            <!-- Zen Scene Cards Grid (19 Scenes) -->
                                            <UniformGrid x:Name="WpZenCards" Columns="3"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 4. Clock, Time Format & Launch Window Settings -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Clock Style -->
                                        <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="16" Padding="16">
                                            <StackPanel>
                                                <TextBlock Text="⏰ Clock &amp; Timer Style" FontWeight="Black" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                                <TextBlock Text="Switch between digital monospace digits and an analog clock face." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="BtnClockStyleDigital" Grid.Column="0" Click="BtnClockStyleDigital_Click" Style="{StaticResource BrandButtonStyle}" Padding="10,8">
                                                        <TextBlock Text="🔢 Digital" FontSize="12"/>
                                                    </Button>
                                                    <Button x:Name="BtnClockStyleAnalog" Grid.Column="2" Click="BtnClockStyleAnalog_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="10,8">
                                                        <TextBlock Text="🕰️ Analog" FontSize="12"/>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Clock Time Format -->
                                        <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="16" Padding="16">
                                            <StackPanel>
                                                <TextBlock Text="⏳ Clock Time Format" FontWeight="Black" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                                <TextBlock Text="Switch between 12-Hour (AM/PM) and 24-Hour railway format." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="BtnTimeFormat12" Grid.Column="0" Click="BtnTimeFormat12_Click" Style="{StaticResource BrandButtonStyle}" Padding="10,8">
                                                        <TextBlock Text="12-Hour (AM/PM)" FontSize="11.5"/>
                                                    </Button>
                                                    <Button x:Name="BtnTimeFormat24" Grid.Column="2" Click="BtnTimeFormat24_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="10,8">
                                                        <TextBlock Text="24-Hour" FontSize="12"/>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Launch Window Mode -->
                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="🖥️ Default Startup Window Mode" FontWeight="Black" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,2"/>
                                                <TextBlock Text="Choose whether StudyHub launches in Windowed or Fullscreen Mode upon launch." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="BtnLaunchWindowed" Click="BtnLaunchWindowed_Click" Style="{StaticResource BrandButtonStyle}" Padding="12,6" Margin="0,0,8,0">
                                                    <TextBlock Text="🗖 Windowed" FontSize="11.5"/>
                                                </Button>
                                                <Button x:Name="BtnLaunchFullscreen" Click="BtnLaunchFullscreen_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6">
                                                    <TextBlock Text="⛶ Fullscreen" FontSize="11.5"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- ================= PARTITION 2: FILE STORAGE & PATHS ================= -->
                                <StackPanel x:Name="SpartStorage" Visibility="Collapsed">
                                    <!-- PDF Reader Opening Behavior -->
                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="📕 PDF Reader Opening Behavior" FontWeight="Black" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Choose whether PDF documents open directly inside StudyHub or launch in your computer's external default application (Adobe Acrobat, Edge, Chrome)." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,14,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <RadioButton x:Name="RbPdfInApp" Content="In-App Split Screen &amp; Reader (Default)" IsChecked="True" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,24,0" Checked="RbPdfMode_Checked"/>
                                                <RadioButton x:Name="RbPdfExternal" Content="External System Application" Foreground="{DynamicResource PrimaryTextBrush}" Checked="RbPdfMode_Checked"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Storage Directories -->
                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="18" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="📂 Local Workspace Directories" FontWeight="Black" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="All your uploaded courses, files, recordings, notes and sounds are safely stored locally on your PC." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,14"/>

                                            <Grid Margin="0,0,0,10">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Base Data &amp; Database Folder" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock x:Name="TxtPathBaseData" Text="E:\Project\Study Hub Remastered" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                </StackPanel>
                                                <Button Click="BtnOpenBaseFolder_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="12,5">
                                                    <TextBlock Text="Open Folder ↗" FontSize="11"/>
                                                </Button>
                                            </Grid>

                                            <Grid Margin="0,0,0,10">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Study Files &amp; PDFs Folder" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock x:Name="TxtPathStudyFiles" Text="E:\Project\Study Hub Remastered\StudyHub_Files" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                </StackPanel>
                                                <Button Click="BtnOpenFilesFolder_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="12,5">
                                                    <TextBlock Text="Open Folder ↗" FontSize="11"/>
                                                </Button>
                                            </Grid>

                                            <Grid>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Ambient White Noise &amp; Sounds Folder" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock x:Name="TxtPathSounds" Text="E:\Project\Study Hub Remastered\StudyHub_Sounds" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                </StackPanel>
                                                <Button Click="BtnOpenSoundsFolder_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="12,5">
                                                    <TextBlock Text="Open Folder ↗" FontSize="11"/>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ================= PARTITION 3: AUDIO & SOUND ================= -->
                                <StackPanel x:Name="SpartAudio" Visibility="Collapsed">
                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,0,16">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="🎵 Import Custom White Noise &amp; Audio" FontWeight="Black" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                                <TextBlock Text="Upload .mp3, .wav, or .ogg ambient focus loops to expand your multi-track focus soundboard." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            </StackPanel>
                                            <Button Click="BtnUploadCustomSound_Click" Style="{StaticResource BrandButtonStyle}" HorizontalAlignment="Right" Padding="16,8">
                                                <TextBlock Text="☁️ Upload Audio (.mp3, .wav)" FontSize="12"/>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Sound Alerts & Timer Chimes -->
                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="18" Padding="18">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="🔔 Notification &amp; Sound Alerts" FontWeight="Black" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                                <TextBlock Text="Play harmonic chimes when Pomodoro work intervals or break sessions complete." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkAudioChimes" IsChecked="True" Checked="ChkAudioChimes_Changed" Unchecked="ChkAudioChimes_Changed" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- ================= PARTITION 4: DATA MANAGEMENT ================= -->
                                <StackPanel x:Name="SpartData" Visibility="Collapsed">
                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="💾 Backup &amp; Restore Workspace Data" FontWeight="Black" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Export all subjects, lecture files, notes, tasks, flashcards, and preferences to a portable backup file, or restore an earlier backup." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,14,12"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Click="BtnExportJsonBackup_Click" Style="{StaticResource BrandButtonStyle}" Margin="0,0,12,0" Padding="16,8">
                                                    <TextBlock Text="📤 Export Backup JSON" FontSize="12"/>
                                                </Button>
                                                <Button Click="BtnImportJsonBackup_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="16,8">
                                                    <TextBlock Text="📥 Import Backup JSON" FontSize="12"/>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Factory Reset -->
                                    <Border x:Name="BdFactoryReset" Background="#2B1420" BorderBrush="#771E2D" BorderThickness="1" CornerRadius="18" Padding="18">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" MaxWidth="520">
                                                <TextBlock Text="⚠️ Factory Reset StudyHub" FontWeight="Black" FontSize="14" Foreground="#F43F5E" Margin="0,0,0,4"/>
                                                <TextBlock x:Name="TxtFactoryResetDesc" Text="Permanently wipes local workspace state and resets all settings to clean defaults. You will be asked to confirm before anything is deleted." FontSize="12" Foreground="#FCA5A5" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Click="BtnFactoryReset_Click" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Right" Padding="16,8">
                                                <TextBlock Text="Reset Everything" FontSize="12"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- ================= PARTITION 5: SYSTEM UTILITIES (GITHUB UPDATER) ================= -->
                                <StackPanel x:Name="SpartSystem" Visibility="Collapsed">
                                    <!-- GitHub Auto-Updater Section -->
                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="🐙 GitHub Auto-Updater" FontWeight="Black" FontSize="15" Foreground="#06B6D4" Margin="0,0,0,4"/>
                                            <TextBlock Text="Paste your GitHub repository link below. StudyHub will check this repository for new releases and automatically download &amp; apply updates seamlessly!" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,14,12"/>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtSettingsGithubUrl" Grid.Column="0" Style="{StaticResource ModernTextBoxStyle}" Text="https://github.com/InfamousToken10729/Study-Hub-Remastered/tree/study_hub" Height="38"/>
                                                <Button Grid.Column="2" Click="BtnCheckGithubUpdates_Click" Style="{StaticResource BrandButtonStyle}" Padding="18,8" Height="38">
                                                    <TextBlock Text="🔍 Check for Updates" FontSize="12.5"/>
                                                </Button>
                                            </Grid>

                                            <CheckBox x:Name="ChkSettingsAutoCheckOnLaunch" Content="Automatically check this link for updates when StudyHub launches" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" Margin="0,0,0,12"/>

                                            <!-- Live Update Status Banner Box -->
                                            <Border x:Name="BdUpdateResultBox" Background="{DynamicResource SubtleBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="12" Padding="14" Visibility="Collapsed">
                                                <StackPanel>
                                                    <TextBlock x:Name="TxtUpdateStatusHeader" Text="Up to date!" FontWeight="Bold" FontSize="13" Foreground="#10B981" Margin="0,0,0,4"/>
                                                    <TextBlock x:Name="TxtUpdateStatusDetails" Text="You are running version v3.0.0." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                                    <Button x:Name="BtnInstallUpdateNow" Click="BtnInstallUpdateNow_Click" Style="{StaticResource BrandButtonStyle}" Visibility="Collapsed" HorizontalAlignment="Left" Padding="16,8">
                                                        <TextBlock Text="⬇️ Download &amp; Apply Update Now"/>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Calendar Reminders & Morning Time Section -->
                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="📅 Calendar Notifications &amp; Morning Time" FontWeight="Black" FontSize="14" Foreground="#A78BFA" Margin="0,0,0,4"/>
                                            <TextBlock Text="Configure when morning calendar reminders trigger and catch missed notifications automatically on launch." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                            <CheckBox x:Name="ChkSettingsCalNotifs" Content="Enable Calendar &amp; Event Reminder Notifications" IsChecked="True" Checked="ChkSettingsCalNotifs_Changed" Unchecked="ChkSettingsCalNotifs_Changed" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" Margin="0,0,0,10"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Morning Notification Time (HH:mm):" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBox x:Name="TxtSettingsMorningHour" Style="{StaticResource ModernTextBoxStyle}" Text="08:00" Width="88" Height="32" Margin="0,0,8,0"/>
                                                <Button Click="BtnSaveMorningHourSetting_Click" Style="{StaticResource BrandButtonStyle}" Padding="14,6" Height="32">
                                                    <TextBlock Text="Save Time" FontSize="11.5"/>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Launch on OS Boot -->
                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,0,16">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="🚀 Launch Automatically on Windows Boot" FontWeight="Black" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                                <TextBlock Text="Register StudyHub in Windows Startup so your workspace is ready as soon as you sign in." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkStartupBoot" Checked="ChkStartupBoot_Changed" Unchecked="ChkStartupBoot_Changed" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Performance Throttle -->
                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="18" Padding="18">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="🔋 Smart Performance Throttle" FontWeight="Black" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                                <TextBlock Text="Pause heavy background particles and throttle canvas FPS when running on battery power." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkPerfThrottle" Checked="ChkPerfThrottle_Changed" Unchecked="ChkPerfThrottle_Changed" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= ADD / EDIT SUBJECT MODAL ================= -->
        <Grid x:Name="SubjectModalGrid" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="360">
            <Border Background="#99000000" MouseDown="SubjectModalBackdrop_MouseDown"/>
            <Border Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="22" Padding="24">
                <StackPanel>
                    <TextBlock x:Name="TxtSubjectModalHeader" Text="Add New Course" FontWeight="Black" FontSize="18" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,16"/>
                    <TextBlock Text="Course Name" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtModalSubjectName" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,14"/>
                    <TextBlock Text="Select Course Icon" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                    <WrapPanel x:Name="IconPickerWrapPanel" Margin="0,0,0,14"/>
                    <TextBlock Text="Select Gradient Color Theme" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                    <WrapPanel x:Name="ColorPickerWrapPanel" Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="BtnCloseSubjectModal_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="16,8">
                            <TextBlock Text="Cancel"/>
                        </Button>
                        <Button Click="BtnSaveSubjectModal_Click" Style="{StaticResource BrandButtonStyle}" Padding="20,8">
                            <TextBlock Text="Save Course"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= CALENDAR, DAY NOTES & UPCOMING EVENTS MODAL ================= -->
        <Grid x:Name="CalendarModalGrid" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="355">
            <Border Background="#AA000000" MouseDown="CalendarModalBackdrop_MouseDown"/>
            <Border MaxWidth="1080" MaxHeight="720" Margin="32,24" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="24" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="38" Height="38" CornerRadius="12" Background="#20183E" Margin="0,0,12,0">
                                <TextBlock Text="📅" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="StudyHub Calendar &amp; Event Reminders" FontSize="19" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock x:Name="TxtPcCalMorningStatus" Text="Morning reminders trigger at 08:00 (and missed alerts notify on launch)" FontSize="11.5" Foreground="#38BDF8"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Morning time:" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtPcCalMorningInline" Style="{StaticResource ModernTextBoxStyle}" Text="08:00" Width="70" Height="30" Margin="0,0,6,0"/>
                            <Button Click="BtnPcCalSaveMorningInline_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,12,0" Height="30">
                                <TextBlock Text="Set" FontSize="11.5"/>
                            </Button>
                            <Button Click="BtnCloseCalendarModal_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Height="30">
                                <TextBlock Text="✕" FontSize="13"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 2-Column Interactive Calendar + Note/Upcoming Content -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="0.95*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Interactive Month Grid + Day Notes -->
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Background="{DynamicResource SubtleBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="18" Padding="16" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Button Click="BtnPcCalPrevMonth_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Padding="12,5">
                                                <TextBlock Text="◀" FontSize="12"/>
                                            </Button>
                                            <TextBlock x:Name="TxtPcCalMonthTitle" Text="November 2026" FontSize="16" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Click="BtnPcCalToday_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" Margin="0,0,6,0">
                                                    <TextBlock Text="Today" FontSize="11.5"/>
                                                </Button>
                                                <Button Click="BtnPcCalNextMonth_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5">
                                                    <TextBlock Text="▶" FontSize="12"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Weekday Header -->
                                        <UniformGrid Columns="7" Margin="0,0,0,6">
                                            <TextBlock Text="Sun" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                                            <TextBlock Text="Mon" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                                            <TextBlock Text="Tue" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                                            <TextBlock Text="Wed" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                                            <TextBlock Text="Thu" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                                            <TextBlock Text="Fri" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                                            <TextBlock Text="Sat" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                                        </UniformGrid>

                                        <UniformGrid x:Name="PcCalMonthDaysGrid" Columns="7" Rows="6"/>
                                    </StackPanel>
                                </Border>

                                <!-- Selected Day Existing Events / Notes -->
                                <Border Background="{DynamicResource SubtleBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="16" Padding="14">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtPcCalSelectedDateHeader" Text="Selected Day: Fri, Nov 13, 2026" FontWeight="Black" FontSize="13.5" Foreground="#FACC15" Margin="0,0,0,8"/>
                                        <StackPanel x:Name="PcCalSelectedDayEventsPanel"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Right Column: Add Event Form & All Upcoming Events Menu -->
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Composer -->
                                <Border Background="{DynamicResource SubtleBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="18" Padding="16" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="📝 Add Note / Event on Selected Day" FontWeight="Black" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10"/>

                                        <TextBlock Text="Title" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtPcCalTitle" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,8"/>

                                        <TextBlock Text="Note" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtPcCalNote" Style="{StaticResource ModernTextBoxStyle}" AcceptsReturn="True" TextWrapping="Wrap" Height="58" Margin="0,0,0,8"/>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Time (HH:mm)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                                <TextBox x:Name="TxtPcCalTime" Style="{StaticResource ModernTextBoxStyle}" Text="09:00"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Link Subject (Optional)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="CmbPcCalSubject" Height="34"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Notify Me Before Event" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                            <Button Click="BtnPcCalSelectAll4_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Padding="10,4">
                                                <TextBlock Text="✓ Select All 4" FontSize="11" Foreground="#38BDF8"/>
                                            </Button>
                                        </Grid>

                                        <WrapPanel Margin="0,0,0,8">
                                            <CheckBox x:Name="ChkPcCal3Days" Content="3 Days Before" IsChecked="True" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" Margin="0,0,14,6"/>
                                            <CheckBox x:Name="ChkPcCal24Hours" Content="24 Hours Before" IsChecked="True" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" Margin="0,0,14,6"/>
                                            <CheckBox x:Name="ChkPcCalMorning" Content="In the Morning" IsChecked="True" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" Margin="0,0,14,6"/>
                                            <CheckBox x:Name="ChkPcCalCustom" Content="Custom" Checked="ChkPcCalCustom_Changed" Unchecked="ChkPcCalCustom_Changed" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" Margin="0,0,0,6"/>
                                        </WrapPanel>

                                        <Grid x:Name="GridPcCalCustomOffset" Visibility="Collapsed" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="85"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtPcCalCustomAmount" Grid.Column="0" Style="{StaticResource ModernTextBoxStyle}" Text="2"/>
                                            <ComboBox x:Name="CmbPcCalCustomUnit" Grid.Column="2" SelectedIndex="0" Height="34">
                                                <ComboBoxItem Content="Hours Before"/>
                                                <ComboBoxItem Content="Minutes Before"/>
                                                <ComboBoxItem Content="Days Before"/>
                                            </ComboBox>
                                        </Grid>

                                        <Button Click="BtnPcCalSaveEvent_Click" Style="{StaticResource BrandButtonStyle}" Padding="14,9">
                                            <TextBlock Text="💾 Save Calendar Note &amp; Schedule Alerts" FontSize="12.5" FontWeight="Bold"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Upcoming Events Menu -->
                                <Border Background="{DynamicResource SubtleBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="18" Padding="16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="🔔 Upcoming Events Menu" FontWeight="Black" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtPcCalUpcomingCount" Text="0 upcoming" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel x:Name="PcCalUpcomingStackPanel"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= PC CALENDAR REMINDER ALERT POPUP (LIVE + MISSED ON LAUNCH) ================= -->
        <Grid x:Name="CalendarAlertModalGrid" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="420">
            <Border Background="#AA000000"/>
            <Border Width="520" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource CardBgBrush}" BorderBrush="#7C5CFF" BorderThickness="2" CornerRadius="22" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="40" Height="40" CornerRadius="12" Background="#2B2158" Margin="0,0,12,0">
                            <TextBlock Text="🔔" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtCalAlertPopupHeader" Text="Calendar Event Reminder" FontSize="17" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock x:Name="TxtCalAlertPopupSub" Text="You have scheduled study reminders ready:" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="340" Margin="0,0,0,16">
                        <StackPanel x:Name="CalAlertPopupItemsPanel"/>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="BtnCalAlertOpenCalendar_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="14,8" Margin="0,0,10,0">
                            <TextBlock Text="📅 Open Calendar"/>
                        </Button>
                        <Button Click="BtnCalAlertDismiss_Click" Style="{StaticResource BrandButtonStyle}" Padding="20,8">
                            <TextBlock Text="Got It ✓"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Toast Notification Popup -->
        <Border x:Name="ToastBorder" Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28" Background="{DynamicResource NavBgBrush}" BorderBrush="#7C5CFF" BorderThickness="1.5" CornerRadius="12" Padding="16,10" Panel.ZIndex="400" Visibility="Collapsed">
            <TextBlock x:Name="TxtToastMessage" Text="Action saved! ✅" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
        </Border>
    </Grid>
</Window>
