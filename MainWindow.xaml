<Window x:Class="StudyHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:controls="clr-namespace:StudyHub.Controls"
        Title="Study Hub v3.0 — Remastered Native Edition"
        Width="1440" Height="900"
        MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#090B1A"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">

    <Grid x:Name="RootMainGrid" Background="Transparent">
        <!-- Main Application Layout Grid -->
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/> <!-- Top Navigation Bar -->
            <RowDefinition Height="*"/>  <!-- Main Workspace / View Switcher -->
        </Grid.RowDefinitions>

        <!-- ================= GLOBAL APP BACKGROUND (STATIC THEME & LIVE PARTICLE CANVAS) ================= -->
        <Grid x:Name="GlobalBgSurface" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False" CacheMode="BitmapCache">
            <Border x:Name="BgBaseLayer" Background="#080A18"/>
            <Border x:Name="BgGlow1"/>
            <Border x:Name="BgGlow2"/>
            <Border x:Name="BgGlow3"/>
        </Grid>
        <Canvas x:Name="GlobalThemeCanvas" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True"/>

        <!-- ================= TOP NAVIGATION BAR ================= -->
        <Border x:Name="TopNavBorder" Grid.Row="0" Background="#F00A0D1E" BorderBrush="#1C223E" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Brand Logo -->
                    <ColumnDefinition Width="*"/>    <!-- Open Spacer Area -->
                    <ColumnDefinition Width="Auto"/> <!-- Right Controls Cluster -->
                </Grid.ColumnDefinitions>

                <!-- 1. Left: StudyHub Brand (Click opens retractable navigation menu) -->
                <Button Click="BtnBrandHome_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="2" ToolTip="StudyHub Navigation Menu">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="12" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7C5CFF" Offset="0.0"/>
                                    <GradientStop Color="#A855F7" Offset="0.5"/>
                                    <GradientStop Color="#22D3EE" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="🎓" FontSize="19" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TxtBrandTitle" Text="StudyHub" FontSize="21" FontWeight="Black" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 2. Center: Empty spacer (keeps layout clean and breathable like Image 2) -->
                <Grid Grid.Column="1"/>

                <!-- 3. Right: Clock, Timer Pill, System Online, Search, Fullscreen, Theme, Zen, Mixer, Settings -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Live Clock Widget Capsule -->
                    <Border x:Name="NavClockBorder" MouseDown="NavClockBorder_MouseDown" Cursor="Hand" Background="#151930" BorderBrush="#252D50" BorderThickness="1" CornerRadius="14" Padding="12,6" Margin="0,0,8,0" ToolTip="Click to toggle 12h / 24h clock format">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🕒" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtNavClockTime" Text="11:05:26 PM" FontWeight="Bold" FontSize="12.5" FontFamily="Consolas, Courier New" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtNavClockDate" Text="Sun, Nov 8" FontSize="11" Foreground="#8A95B7" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Top Bar Focus Timer Pill (Visible when docked to Top Bar) -->
                    <Border x:Name="NavTimerPill" MouseDown="NavTimerPill_MouseDown" Cursor="Hand" Background="#261324" BorderBrush="#4A1C36" BorderThickness="1" CornerRadius="14" Padding="12,6" Margin="0,0,8,0" Visibility="Collapsed" ToolTip="Focus Timer (Click for controls or move back to corner)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 10,2 L 14,2" Stroke="#F43F5E" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Path Data="M 12,2 L 12,5" Stroke="#F43F5E" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Ellipse Width="15" Height="15" Canvas.Left="4.5" Canvas.Top="5.5" Fill="#F43F5E"/>
                                    <Path Data="M 12,13 L 15,9.5" Stroke="White" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="TxtNavTimerDisplay" Text="25:00" FontWeight="Black" FontFamily="Consolas, Courier New" FontSize="12.5" Foreground="#F472B6" VerticalAlignment="Center"/>
                            <Ellipse x:Name="NavTimerStatusDot" Width="6" Height="6" Fill="#10B981" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="⌄" FontSize="10" Foreground="#8A95B7" Margin="4,-2,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Search Pill with Ctrl+K Keyboard Badge -->
                    <Border x:Name="NavSearchPill" Width="170" Height="36" Background="#151930" BorderBrush="#252D50" BorderThickness="1" CornerRadius="14" Padding="10,0" Margin="0,0,8,0" ToolTip="Search workspace (Ctrl+K)">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="11.5" Foreground="#8A95B7" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtGlobalSearch" Grid.Column="1" Text="" Background="Transparent" Foreground="#F8FAFC" BorderThickness="0" FontSize="12" VerticalAlignment="Center" KeyDown="TxtGlobalSearch_KeyDown" GotFocus="TxtGlobalSearch_GotFocus" LostFocus="TxtGlobalSearch_LostFocus"/>
                            <TextBlock x:Name="TxtGlobalSearchPlaceholder" Grid.Column="1" Text="Search..." Foreground="#8A95B7" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <Border x:Name="BdNavSearchShortcut" Grid.Column="2" Background="#222846" CornerRadius="5" Padding="5,2" Margin="4,0,0,0">
                                <TextBlock x:Name="TxtNavSearchShortcut" Text="Ctrl+K" FontSize="9.5" FontWeight="Bold" Foreground="#8A95B7"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Circular Action Buttons: Calendar, Sound Mixer, Zen Mode, Theme, Fullscreen, Settings -->
                    <Grid Margin="0,0,8,0">
                        <Button x:Name="BtnNavCalendar" Click="BtnNavCalendar_Click" Style="{StaticResource CircularNavButtonStyle}" ToolTip="Calendar &amp; Upcoming Events">
                            <TextBlock Text="📅" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Ellipse x:Name="NavCalendarDot" Width="8" Height="8" Fill="#F59E0B" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" Visibility="Collapsed"/>
                    </Grid>

                    <Grid Margin="0,0,8,0">
                        <Button x:Name="BtnNavSoundMixer" Click="BtnNavSoundMixer_Click" Style="{StaticResource CircularNavButtonStyle}" ToolTip="Sound Studio &amp; Mixer (Ctrl+M)">
                            <TextBlock Text="🎚️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Ellipse x:Name="NavMixerDot" Width="8" Height="8" Fill="#10B981" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" Visibility="Collapsed"/>
                    </Grid>

                    <Button x:Name="BtnNavZen" Click="BtnNavZen_Click" Style="{StaticResource CircularNavButtonStyle}" Margin="0,0,8,0" ToolTip="Zen Study Mode (F10)">
                        <TextBlock Text="🧘" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Button x:Name="BtnNavTheme" Click="BtnNavTheme_Click" Style="{StaticResource CircularNavButtonStyle}" Margin="0,0,8,0" ToolTip="Toggle Dark / Light Theme">
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="24" Height="24">
                                <!-- Radiant Yellow Sun Vector (Dark Mode -> Switch to Daylight) -->
                                <Canvas x:Name="GridThemeSunIcon" Width="24" Height="24" Visibility="Visible">
                                    <Ellipse Width="19" Height="19" Canvas.Left="2.5" Canvas.Top="2.5">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#4CFDE047" Offset="0.0"/>
                                                <GradientStop Color="#1CFBBF24" Offset="0.6"/>
                                                <GradientStop Color="#00F59E0B" Offset="1.0"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <!-- 8 Detached Crisp Sunbeams -->
                                    <Line X1="12" Y1="4.7" X2="12" Y2="1.7" Stroke="#FDE047" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="12" Y1="19.3" X2="12" Y2="22.3" Stroke="#FBBF24" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="4.7" Y1="12" X2="1.7" Y2="12" Stroke="#FDE047" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="19.3" Y1="12" X2="22.3" Y2="12" Stroke="#FBBF24" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="17.16" Y1="6.84" X2="19.14" Y2="4.86" Stroke="#FDE047" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="6.84" Y1="6.84" X2="4.86" Y2="4.86" Stroke="#FDE047" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="17.16" Y1="17.16" X2="19.14" Y2="19.14" Stroke="#FBBF24" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="6.84" Y1="17.16" X2="4.86" Y2="19.14" Stroke="#FBBF24" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <!-- Sun Core -->
                                    <Ellipse Width="10" Height="10" Canvas.Left="7" Canvas.Top="7">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush GradientOrigin="0.35,0.35">
                                                <GradientStop Color="#FEF08A" Offset="0.0"/>
                                                <GradientStop Color="#FACC15" Offset="0.55"/>
                                                <GradientStop Color="#F59E0B" Offset="1.0"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#FBBF24" BlurRadius="5" ShadowDepth="0" Opacity="0.7"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                </Canvas>

                                <!-- Sculpted Crescent Moon + Stars Vector (Light Mode -> Switch to Night) -->
                                <Canvas x:Name="GridThemeMoonIcon" Width="24" Height="24" Visibility="Collapsed">
                                    <Path Stroke="#E0E7FF" StrokeThickness="0.65">
                                        <Path.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#6366F1" Offset="0.0"/>
                                                <GradientStop Color="#4F46E5" Offset="0.55"/>
                                                <GradientStop Color="#4338CA" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Path.Fill>
                                        <Path.Data>
                                            <CombinedGeometry GeometryCombineMode="Exclude">
                                                <CombinedGeometry.Geometry1>
                                                    <EllipseGeometry Center="10.8,12.8" RadiusX="7.6" RadiusY="7.6"/>
                                                </CombinedGeometry.Geometry1>
                                                <CombinedGeometry.Geometry2>
                                                    <EllipseGeometry Center="15.0,8.8" RadiusX="6.4" RadiusY="6.4"/>
                                                </CombinedGeometry.Geometry2>
                                            </CombinedGeometry>
                                        </Path.Data>
                                    </Path>
                                    <!-- Twinkling Stars -->
                                    <Path Fill="#FBBF24" Data="M 17.5,3.2 L 18.2,5.3 L 20.3,6.0 L 18.2,6.7 L 17.5,8.8 L 16.8,6.7 L 14.7,6.0 L 16.8,5.3 Z"/>
                                    <Path Fill="#818CF8" Data="M 20.4,10.2 L 20.85,11.35 L 22.0,11.8 L 20.85,12.25 L 20.4,13.4 L 19.95,12.25 L 18.8,11.8 L 19.95,11.35 Z"/>
                                </Canvas>
                            </Grid>
                        </Viewbox>
                    </Button>

                    <Button x:Name="BtnNavFullscreen" Click="BtnNavFullscreen_Click" Style="{StaticResource CircularNavButtonStyle}" Margin="0,0,8,0" ToolTip="Toggle Fullscreen (F11)">
                        <TextBlock x:Name="TxtNavFullscreenIcon" Text="⛶" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Button x:Name="BtnNavSettings" Click="BtnNavSettings_Click" Style="{StaticResource CircularNavButtonStyle}" ToolTip="Settings &amp; Preferences">
                        <TextBlock Text="⚙️" FontSize="14" Foreground="#FBBF24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN WORKSPACE CONTENT AREA ================= -->
        <Grid Grid.Row="1">
            <!-- 1. HOME VIEW (Dashboard & Subjects Grid) -->
            <ScrollViewer x:Name="HomeViewScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,20">
                <StackPanel HorizontalAlignment="Stretch">
                    <!-- Welcome Banner (Spans workspace edge-to-edge) -->
                    <Border x:Name="BdBanner" Background="#11152A" BorderBrush="#1F2648" BorderThickness="1" CornerRadius="24" Padding="28,24" Margin="0,0,0,24" HorizontalAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Tag, Title, Subtitle, Stats -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                <!-- Dynamic Greeting Tag -->
                                <Border x:Name="BdGreetingTag" Background="#1D1735" BorderBrush="#3B2B63" BorderThickness="1" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox x:Name="GridGreetingSunIcon" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed">
                                            <Canvas Width="24" Height="24">
                                                <Line X1="12" Y1="4.7" X2="12" Y2="1.7" Stroke="#F59E0B" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <Line X1="12" Y1="19.3" X2="12" Y2="22.3" Stroke="#F59E0B" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <Line X1="4.7" Y1="12" X2="1.7" Y2="12" Stroke="#F59E0B" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <Line X1="19.3" Y1="12" X2="22.3" Y2="12" Stroke="#F59E0B" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <Line X1="17.16" Y1="6.84" X2="19.14" Y2="4.86" Stroke="#FBBF24" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <Line X1="6.84" Y1="6.84" X2="4.86" Y2="4.86" Stroke="#FBBF24" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <Line X1="17.16" Y1="17.16" X2="19.14" Y2="19.14" Stroke="#FBBF24" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <Line X1="6.84" Y1="17.16" X2="4.86" Y2="19.14" Stroke="#FBBF24" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <Ellipse Width="10" Height="10" Canvas.Left="7" Canvas.Top="7">
                                                    <Ellipse.Fill>
                                                        <RadialGradientBrush GradientOrigin="0.35,0.35">
                                                            <GradientStop Color="#FEF08A" Offset="0.0"/>
                                                            <GradientStop Color="#FACC15" Offset="0.55"/>
                                                            <GradientStop Color="#F59E0B" Offset="1.0"/>
                                                        </RadialGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="TxtGreetingIcon" Text="⚡" FontSize="11" Foreground="#FBBF24" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtGreetingBadge" Text="NIGHT OWL MODE 🌙" FontSize="11" FontWeight="Bold" Foreground="#C084FC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Gradient Title: "Your study workspace 🚀" -->
                                <TextBlock FontSize="32" FontWeight="Black" Margin="0,0,0,6">
                                    <Run x:Name="TxtWelcomeYour" Text="Your " Foreground="#F8FAFC"/>
                                    <Run Text="study workspace">
                                        <Run.Foreground>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#8B5CF6" Offset="0.0"/>
                                                <GradientStop Color="#EC4899" Offset="0.5"/>
                                                <GradientStop Color="#06B6D4" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Run.Foreground>
                                    </Run>
                                    <Run x:Name="TxtWelcomeRocket" Text=" 🚀" Foreground="#F8FAFC"/>
                                </TextBlock>

                                <!-- Subtitle -->
                                <TextBlock x:Name="TxtHomeSubtitle" Text="Organize your study materials, focus deeply, and crush your goals." FontSize="13.5" Foreground="#8A95B7" Margin="0,0,0,18"/>

                                <!-- Inline Uptime Stats & Top Subject Capsule -->
                                <Border x:Name="BdUptimeCapsule" Background="#0A0D1D" BorderBrush="#1A203B" BorderThickness="1" CornerRadius="14" Padding="12,6" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="BdUptimeClockBox" Width="26" Height="26" CornerRadius="8" Background="#0C2B36" Margin="0,0,8,0">
                                            <TextBlock Text="🕒" FontSize="12" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock FontSize="12.5" VerticalAlignment="Center">
                                            <Run x:Name="TxtHomeSessionUptime" Text="0m" FontWeight="Bold" Foreground="#F8FAFC"/>
                                            <Run x:Name="TxtUptimeActiveLabel" Text=" active" Foreground="#8A95B7"/>
                                        </TextBlock>

                                        <Border x:Name="BdUptimeDivider" Width="1" Height="16" Background="#1A203B" Margin="14,0"/>

                                        <Border x:Name="BdUptimeCrownBox" Width="26" Height="26" CornerRadius="8" Background="#342712" Margin="0,0,8,0">
                                            <TextBlock Text="👑" FontSize="12" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock FontSize="12.5" VerticalAlignment="Center">
                                            <Run x:Name="TxtUptimeTopLabel" Text="Top: " Foreground="#8A95B7"/>
                                            <Run x:Name="TxtHomeTopSubject" Text="Avionics" FontWeight="Bold" Foreground="#F8FAFC"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Right: 30-Day Activity Heatmap & Focus Ratio Card -->
                            <Border x:Name="BdHeatmapCard" Grid.Column="1" Background="#0B0E20" BorderBrush="#1C223E" BorderThickness="1" CornerRadius="20" Padding="18,14" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel Margin="0,0,16,0">
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock x:Name="TxtHeatmapTitle" Text="Study Heatmap (30 Days)" FontSize="12" FontWeight="Bold" Foreground="#8A95B7" VerticalAlignment="Center" Margin="0,0,24,0"/>
                                            <TextBlock Text="🔥" FontSize="14" Foreground="#F97316" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <WrapPanel x:Name="HeatmapWrapPanel" Width="175" Height="48"/>
                                    </StackPanel>
                                    <Border x:Name="BdHeatmapDivider" Width="1" Background="#1C223E" Margin="0,0,18,0"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="75">
                                        <TextBlock x:Name="TxtFocusRatioLabel" Text="Focus Ratio" FontSize="11" FontWeight="Bold" Foreground="#8A95B7" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <Border x:Name="BdFocusRatioRing" Width="52" Height="52" CornerRadius="26" BorderBrush="#10B981" BorderThickness="2.5" Background="Transparent" HorizontalAlignment="Center">
                                            <TextBlock x:Name="TxtHomeFocusRatio" Text="0%" FontSize="16" FontWeight="Black" Foreground="#8A95B7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Smart Upcoming Events Menu Card (Synced with Calendar & Subject Deadlines) -->
                    <Border x:Name="BdHomeUpcomingEvents" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="20" Padding="20,14" Margin="0,0,0,22" HorizontalAlignment="Stretch">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="32" Height="32" CornerRadius="10" Background="#20183E" Margin="0,0,10,0">
                                        <TextBlock Text="📅" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Upcoming Events" FontSize="16" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Border Background="#232B54" CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtHomeUpcomingCount" Text="0" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="BtnHomeUpcomingExpand" Click="BtnHomeUpcomingExpand_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" Margin="0,0,8,0" Visibility="Collapsed">
                                        <TextBlock x:Name="TxtHomeUpcomingExpand" Text="Show All ▾" FontSize="11.5"/>
                                    </Button>
                                    <Button Click="BtnOpenAddCalendarNote_Click" Style="{StaticResource BrandButtonStyle}" Padding="12,6" Margin="0,0,8,0">
                                        <TextBlock Text="+ Add Calendar Note" FontSize="12"/>
                                    </Button>
                                    <Button Click="BtnNavCalendar_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6">
                                        <TextBlock Text="Open Calendar ▸" FontSize="12"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="HomeUpcomingStackPanel"/>
                        </StackPanel>
                    </Border>

                    <!-- Subjects Section Header (Clean squircle book icon + bold title; no right button, matching Image 2) -->
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="BdSectionIconBox" Width="38" Height="38" CornerRadius="12" Background="#20183E" Margin="0,0,12,0">
                                <TextBlock Text="📖" FontSize="16" Foreground="#7C5CFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="TxtSectionTitle" Text="My Subjects" FontSize="22" FontWeight="Black" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Subjects Dynamic Cards Grid (Fills full width seamlessly) -->
                    <WrapPanel x:Name="SubjectsWrapPanel" HorizontalAlignment="Stretch" Margin="-8,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- 2. SUBJECT DETAIL WORKSPACE VIEW -->
            <Grid x:Name="SubjectDetailGrid" Visibility="Collapsed" Background="#090B1A">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Subject Banner -->
                    <RowDefinition Height="Auto"/> <!-- Segmented Capsule Tabs -->
                    <RowDefinition Height="*"/>    <!-- Sub-tab Content Workspace -->
                </Grid.RowDefinitions>

                <!-- Subject Header Banner -->
                <Border x:Name="BdSubjectDetailHeader" Grid.Row="0" Background="#181D38" BorderBrush="#283056" BorderThickness="0,0,0,1" Padding="24,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Back Button & Course Details -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Click="BtnBackToHome_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,16,0" Padding="12,7" ToolTip="Back to Courses">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⬅️" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Courses" FontWeight="Bold" FontSize="12.5"/>
                                </StackPanel>
                            </Button>
                            <Border x:Name="BdSubjectIconBox" Width="44" Height="44" CornerRadius="12" Background="#7C5CFF" Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtSubjectDetailIcon" Text="🎓" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TxtActiveSubjectTitle" Text="Avionics" FontSize="22" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <Button Click="BtnEditCurrentSubject_Click" Background="Transparent" BorderThickness="0" Margin="8,0,0,0" Cursor="Hand" ToolTip="Edit course details">
                                        <TextBlock Text="✏️" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </Button>
                                </StackPanel>
                                <TextBlock x:Name="TxtActiveSubjectStats" Text="8 Files • 0 Videos • 0 Notes • 0 Tasks • 0 Events" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right: Course Actions -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnArchiveCurrentSubject" Click="BtnArchiveCurrentSubject_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="12,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📦" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Archive Course" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Modern Segmented Pill Tabs with Live Count Badges -->
                <Border x:Name="BdSubjectDetailTabs" Grid.Row="1" Background="#11152C" BorderBrush="#283056" BorderThickness="0,0,0,1" Padding="20,8">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="TabBtnFiles" Click="TabBtn_Click" Tag="Files" Style="{StaticResource BrandButtonStyle}" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁 Files" FontWeight="Bold"/>
                                    <Border Background="#33FFFFFF" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                                        <TextBlock x:Name="BadgeTabFiles" Text="0" FontSize="11" FontWeight="Black"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TabBtnVideos" Click="TabBtn_Click" Tag="Videos" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎬 Videos" FontWeight="Bold"/>
                                    <Border Background="{DynamicResource SubtleBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                                        <TextBlock x:Name="BadgeTabVideos" Text="0" FontSize="11" FontWeight="Black" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TabBtnRecordings" Click="TabBtn_Click" Tag="Recordings" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎙️ Recordings" FontWeight="Bold"/>
                                    <Border Background="{DynamicResource SubtleBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                                        <TextBlock x:Name="BadgeTabRecordings" Text="0" FontSize="11" FontWeight="Black" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TabBtnNotes" Click="TabBtn_Click" Tag="Notes" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📝 Notes" FontWeight="Bold"/>
                                    <Border Background="{DynamicResource SubtleBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                                        <TextBlock x:Name="BadgeTabNotes" Text="0" FontSize="11" FontWeight="Black" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TabBtnTasks" Click="TabBtn_Click" Tag="Tasks" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✅ Tasks" FontWeight="Bold"/>
                                    <Border Background="{DynamicResource SubtleBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                                        <TextBlock x:Name="BadgeTabTasks" Text="0" FontSize="11" FontWeight="Black" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TabBtnLinks" Click="TabBtn_Click" Tag="Links" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔗 Links" FontWeight="Bold"/>
                                    <Border Background="{DynamicResource SubtleBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                                        <TextBlock x:Name="BadgeTabLinks" Text="0" FontSize="11" FontWeight="Black" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TabBtnDeadlines" Click="TabBtn_Click" Tag="Deadlines" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📅 Deadlines" FontWeight="Bold"/>
                                    <Border Background="{DynamicResource SubtleBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                                        <TextBlock x:Name="BadgeTabDeadlines" Text="0" FontSize="11" FontWeight="Black" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TabBtnFlashcards" Click="TabBtn_Click" Tag="Flashcards" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎴 Flashcards" FontWeight="Bold"/>
                                    <Border Background="{DynamicResource SubtleBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                                        <TextBlock x:Name="BadgeTabFlashcards" Text="0" FontSize="11" FontWeight="Black" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TabBtnWhiteboard" Click="TabBtn_Click" Tag="Whiteboard" Style="{StaticResource SecondaryButtonStyle}">
                                <TextBlock Text="🎨 Whiteboard" FontWeight="Bold"/>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Sub-tab Workspaces -->
                <Grid x:Name="SubjectWorkspaceGrid" Grid.Row="2" Background="#090B1A">
                    <!-- 1. Files Tab Content -->
                    <Grid x:Name="TabFilesWorkspace" Margin="24,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Action bar -->
                            <RowDefinition Height="*"/>    <!-- Folders & Files -->
                        </Grid.RowDefinitions>

                        <!-- Action Bar: Add Folder, Expand All, Filter files, Upload Files -->
                        <Border x:Name="BdFilesActionBar" Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="16" Padding="14,10" Margin="0,0,0,16">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Click="BtnPromptNewFolder_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="12,6">
                                        <TextBlock Text="📁+ New Folder" FontWeight="Bold" FontSize="12"/>
                                    </Button>
                                    <Button x:Name="BtnToggleExpandAllFolders" Click="BtnToggleExpandAllFolders_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0" Padding="12,6">
                                        <TextBlock x:Name="TxtExpandAllBtn" Text="⊞ Expand All" FontWeight="Bold" FontSize="12"/>
                                    </Button>
                                    <Border Width="240" Height="34" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="10" Padding="10,0">
                                        <Grid VerticalAlignment="Center">
                                            <TextBox x:Name="TxtFilterFiles" Text="" Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0" FontSize="12.5" TextChanged="TxtFilterFiles_TextChanged"/>
                                            <TextBlock x:Name="TxtFilterFilesPlaceholder" Text="Filter files in folders..." Foreground="{DynamicResource MutedTextBrush}" FontSize="12" IsHitTestVisible="False"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <Button Click="BtnUploadFiles_Click" Style="{StaticResource BrandButtonStyle}" HorizontalAlignment="Right" Padding="16,7">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="☁️ Upload Files" FontWeight="Bold" FontSize="12.5"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Folders StackPanel -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="FoldersStackPanel"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- 2. Split Screen View (Notes + Document / Info) -->
                    <Grid x:Name="TabSplitWorkspace" Visibility="Collapsed" Margin="24,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="300"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*" MinWidth="300"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Panel: Course Notes -->
                        <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="18" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="📝 Lecture Notes" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                    <Button Click="BtnSaveSplitNotes_Click" Style="{StaticResource BrandButtonStyle}" HorizontalAlignment="Right" Padding="12,5" FontSize="11">
                                        <TextBlock Text="💾 Save Notes"/>
                                    </Button>
                                </Grid>
                                <TextBox x:Name="TxtSplitNotes" Grid.Row="1" Style="{StaticResource ModernTextBoxStyle}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Courier New" FontSize="13.5"/>
                            </Grid>
                        </Border>

                        <!-- Resizable Splitter -->
                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrushTheme}" Cursor="SizeWE"/>

                        <!-- Right Panel: Document Preview / External Action -->
                        <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="18" Padding="24">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                                <TextBlock Text="📄" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock x:Name="TxtSplitDocTitle" Text="Sheet #3.pdf" FontSize="18" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock Text="You are in Split Screen Mode! Review your lecture files on the right while taking synchronized notes on the left." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20"/>
                                <Button Click="BtnOpenSplitDocExternal_Click" Style="{StaticResource BrandButtonStyle}" HorizontalAlignment="Center" Padding="20,10">
                                    <TextBlock Text="🚀 Open with System App (Adobe Acrobat / Edge)" FontWeight="Bold"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 3. Videos Workspace (MediaElement + Sync Notes) -->
                    <Grid x:Name="TabVideosWorkspace" Visibility="Collapsed" Margin="24,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Videos Playlist -->
                        <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,16,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="🎬 Video Lectures" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                    <Button Click="BtnUploadVideo_Click" Style="{StaticResource BrandButtonStyle}" HorizontalAlignment="Right" Padding="10,4" FontSize="11">
                                        <TextBlock Text="+ Add"/>
                                    </Button>
                                </Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="VideosListStackPanel"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Right: Player & Notes -->
                        <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="16" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#090B1A" CornerRadius="12" ClipToBounds="True">
                                    <MediaElement x:Name="StudioVideoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" ScrubbingEnabled="True"/>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                    <Slider x:Name="VideoSeekSlider" Minimum="0" Maximum="100" Style="{StaticResource StudioSliderStyle}" ValueChanged="VideoSeekSlider_ValueChanged" Margin="0,0,0,10"/>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Click="BtnVideoPlay_Click" Style="{StaticResource BrandButtonStyle}" Padding="14,6" Margin="0,0,8,0">
                                                <TextBlock Text="▶️ Play"/>
                                            </Button>
                                            <Button Click="BtnVideoPause_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="14,6" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="2.5" Height="10" CornerRadius="1" Background="{DynamicResource PrimaryTextBrush}" Margin="0,0,2.5,0"/>
                                                    <Border Width="2.5" Height="10" CornerRadius="1" Background="{DynamicResource PrimaryTextBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Pause" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Click="BtnVideoStop_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="14,6">
                                                <TextBlock Text="⏹️ Stop"/>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtVideoTimeDisplay" Text="00:00 / 00:00" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 4. Recordings Workspace -->
                    <Grid x:Name="TabRecordingsWorkspace" Visibility="Collapsed" Margin="24,16">
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="18" Padding="24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <TextBlock Text="🎙️ Lecture Voice Recordings" FontWeight="Black" FontSize="16" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,14"/>
                                    <Border Background="{DynamicResource SubtleBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="Record New Audio Lecture" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10"/>
                                            <TextBox x:Name="TxtRecordTitle" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,10" Tag="Recording title..."/>
                                            <Button Click="BtnImportRecordingFile_Click" Style="{StaticResource BrandButtonStyle}">
                                                <TextBlock Text="📁 Import Audio (MP3 / WAV / M4A)"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="380">
                                        <StackPanel x:Name="RecordingsListStackPanel"/>
                                    </ScrollViewer>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource SubtleBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="14" Padding="18">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Synchronized Lecture Notes" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                                        <TextBox x:Name="TxtRecordingNotes" Grid.Row="1" Style="{StaticResource ModernTextBoxStyle}" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas, Courier New" FontSize="13.5"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 5. Notes Workspace -->
                    <Grid x:Name="TabNotesWorkspace" Visibility="Collapsed" Margin="24,16">
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="18" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📝 Course Notes Editor" FontWeight="Black" FontSize="16" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock x:Name="TxtNotesWordCount" Text="0 words • 0 chars" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Click="BtnExportNotesTxt_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="12,6">
                                            <TextBlock Text="📥 Export .TXT"/>
                                        </Button>
                                        <Button Click="BtnSaveNotes_Click" Style="{StaticResource BrandButtonStyle}" Padding="16,6">
                                            <TextBlock Text="💾 Save Notes"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <TextBox x:Name="TxtSubjectNotes" Grid.Row="1" Style="{StaticResource ModernTextBoxStyle}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Segoe UI, Consolas" FontSize="14.5" TextChanged="TxtSubjectNotes_TextChanged"/>
                                <TextBlock Grid.Row="2" Text="Tip: Notes automatically save with your study material. Use Markdown headings and bullet points." Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5" Margin="0,8,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 6. Tasks Workspace -->
                    <Grid x:Name="TabTasksWorkspace" Visibility="Collapsed" Margin="24,16">
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="18" Padding="24" MaxWidth="900" HorizontalAlignment="Left">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="✅ Course Tasks &amp; Action Items" FontWeight="Black" FontSize="18" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,16"/>
                                <Grid Grid.Row="1" Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtNewTaskTitle" Grid.Column="0" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,8,0" KeyDown="TxtNewTaskTitle_KeyDown"/>
                                    <ComboBox x:Name="CmbTaskPriority" Grid.Column="1" SelectedIndex="1" Margin="0,0,8,0" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
                                        <ComboBoxItem Content="Low Priority"/>
                                        <ComboBoxItem Content="Medium"/>
                                        <ComboBoxItem Content="High Priority"/>
                                    </ComboBox>
                                    <Button Grid.Column="2" Click="BtnAddTask_Click" Style="{StaticResource BrandButtonStyle}" Padding="16,8">
                                        <TextBlock Text="➕ Add Task"/>
                                    </Button>
                                </Grid>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="520">
                                    <StackPanel x:Name="TasksListStackPanel"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 7. Links Workspace -->
                    <Grid x:Name="TabLinksWorkspace" Visibility="Collapsed" Margin="24,16">
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="18" Padding="24" MaxWidth="850" HorizontalAlignment="Left">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="🔗 Reference Links &amp; Bookmarks" FontWeight="Black" FontSize="18" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,16"/>
                                <Grid Grid.Row="1" Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtLinkTitle" Grid.Column="0" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TxtLinkUrl" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Click="BtnAddLink_Click" Style="{StaticResource BrandButtonStyle}" Padding="16,8">
                                        <TextBlock Text="➕ Add Link"/>
                                    </Button>
                                </Grid>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="520">
                                    <StackPanel x:Name="LinksListStackPanel"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 8. Deadlines Workspace -->
                    <Grid x:Name="TabDeadlinesWorkspace" Visibility="Collapsed" Margin="24,16">
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="18" Padding="24" MaxWidth="850" HorizontalAlignment="Left">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="📅 Deadlines, Quizzes &amp; Exams" FontWeight="Black" FontSize="18" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,16"/>
                                <Grid Grid.Row="1" Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtDeadlineTitle" Grid.Column="0" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,8,0"/>
                                    <DatePicker x:Name="DpDeadlineDate" Grid.Column="1" Margin="0,0,8,0" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <Button Grid.Column="2" Click="BtnAddDeadline_Click" Style="{StaticResource BrandButtonStyle}" Padding="16,8">
                                        <TextBlock Text="➕ Add Event"/>
                                    </Button>
                                </Grid>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="520">
                                    <StackPanel x:Name="DeadlinesListStackPanel"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 9. Flashcards Workspace -->
                    <Grid x:Name="TabFlashcardsWorkspace" Visibility="Collapsed" Margin="24,16">
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="18" Padding="24" MaxWidth="800" HorizontalAlignment="Center">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="🎴 Flashcard Study Deck" FontWeight="Black" FontSize="18" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                                <!-- 3D Flip Card Container -->
                                <Border x:Name="BdFlashcard" Grid.Row="1" MouseDown="BdFlashcard_MouseDown" Width="520" Height="260" Background="{DynamicResource SubtleBgBrush}" BorderBrush="#7C5CFF" BorderThickness="2" CornerRadius="20" Cursor="Hand" Padding="28" VerticalAlignment="Center" ToolTip="Click to flip card!">
                                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="TxtFlashcardContent" Text="Click here to flip front/back!" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                    <Button Click="BtnPrevFlashcard_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Padding="16,8">
                                        <TextBlock Text="⬅️ Previous"/>
                                    </Button>
                                    <Button Click="BtnNextFlashcard_Click" Style="{StaticResource BrandButtonStyle}" Margin="0,0,10,0" Padding="16,8">
                                        <TextBlock Text="Next Card ➡️"/>
                                    </Button>
                                    <Button Click="BtnAddFlashcardPrompt_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="14,8">
                                        <TextBlock Text="➕ New Card"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 10. Whiteboard Workspace (WPF Native InkCanvas) -->
                    <Grid x:Name="TabWhiteboardWorkspace" Visibility="Collapsed" Margin="20,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Whiteboard Toolbar -->
                        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="14" Padding="14,8" Margin="0,0,0,10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Click="BtnInkPen_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="10,5">
                                        <TextBlock Text="🖊️ Pen"/>
                                    </Button>
                                    <Button Click="BtnInkHighlighter_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="10,5">
                                        <TextBlock Text="🖍️ Highlighter"/>
                                    </Button>
                                    <Button Click="BtnInkEraser_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,14,0" Padding="10,5">
                                        <TextBlock Text="⌫ Eraser"/>
                                    </Button>

                                    <!-- Color Swatches -->
                                    <Border Width="24" Height="24" CornerRadius="12" Background="#0F172A" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" Margin="0,0,6,0" MouseDown="ColorSwatch_MouseDown" Tag="#0F172A" Cursor="Hand"/>
                                    <Border Width="24" Height="24" CornerRadius="12" Background="#FFFFFF" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" Margin="0,0,6,0" MouseDown="ColorSwatch_MouseDown" Tag="#FFFFFF" Cursor="Hand"/>
                                    <Border Width="24" Height="24" CornerRadius="12" Background="#7C5CFF" Margin="0,0,6,0" MouseDown="ColorSwatch_MouseDown" Tag="#7C5CFF" Cursor="Hand"/>
                                    <Border Width="24" Height="24" CornerRadius="12" Background="#22D3EE" Margin="0,0,6,0" MouseDown="ColorSwatch_MouseDown" Tag="#22D3EE" Cursor="Hand"/>
                                    <Border Width="24" Height="24" CornerRadius="12" Background="#F43F5E" Margin="0,0,6,0" MouseDown="ColorSwatch_MouseDown" Tag="#F43F5E" Cursor="Hand"/>
                                    <Border Width="24" Height="24" CornerRadius="12" Background="#10B981" Margin="0,0,14,0" MouseDown="ColorSwatch_MouseDown" Tag="#10B981" Cursor="Hand"/>

                                    <TextBlock Text="Size:" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Slider x:Name="SliderInkSize" Width="80" Minimum="1" Maximum="24" Value="3" Style="{StaticResource StudioSliderStyle}" ValueChanged="SliderInkSize_ValueChanged" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Click="BtnClearWhiteboard_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="12,5">
                                        <TextBlock Text="Clear Canvas"/>
                                    </Button>
                                    <Button Click="BtnSaveWhiteboardPng_Click" Style="{StaticResource BrandButtonStyle}" Padding="14,5">
                                        <TextBlock Text="💾 Save PNG"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- Native InkCanvas -->
                        <Border Grid.Row="1" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="16" ClipToBounds="True">
                            <InkCanvas x:Name="MainWhiteboardCanvas" Background="{DynamicResource InputBgBrush}"/>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ================= TIMER DRAG SNAP ZONES OVERLAY ================= -->
        <Grid x:Name="TimerSnapOverlayGrid" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="305">
            <!-- Top Bar Snap Target -->
            <Border x:Name="SnapZoneTop" Width="320" Height="48" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,72,24,0" CornerRadius="14" Background="#2E7C5CFF" BorderBrush="#7C5CFF" BorderThickness="1.5">
                <TextBlock Text="⬆ Snap to Top Bar" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <!-- Bottom Left Snap Target -->
            <Border x:Name="SnapZoneBottomLeft" Width="288" Height="74" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,0,0,24" CornerRadius="22" Background="#227C5CFF" BorderBrush="#7C5CFF" BorderThickness="1.5">
                <TextBlock Text="↙ Snap to Bottom Left" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <!-- Bottom Right Snap Target -->
            <Border x:Name="SnapZoneBottomRight" Width="288" Height="74" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" CornerRadius="22" Background="#227C5CFF" BorderBrush="#7C5CFF" BorderThickness="1.5">
                <TextBlock Text="↘ Snap to Bottom Right" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- ================= FLOATING DOCKABLE FOCUS TIMER ================= -->
        <Border x:Name="FloatingPomodoroWidget" Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Background="#181D38" BorderBrush="#283056" BorderThickness="1" CornerRadius="22" Width="288" Panel.ZIndex="310" Visibility="Visible">
            <Border.RenderTransform>
                <TranslateTransform x:Name="PomoDragTransform"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.32"/>
            </Border.Effect>
            <Grid x:Name="PomoClipGrid" SizeChanged="PomoClipGrid_SizeChanged">
                <StackPanel x:Name="PomoBodyStack" Margin="18,14,18,16">
                    <!-- Header Row: Left Stopwatch + Title (+ Min Time Badge), Right ONLY Settings & Drop Arrow -->
                    <Grid x:Name="PomoHeaderRow" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="PomoHeaderRow_MouseLeftButtonDown" MouseMove="PomoHeaderRow_MouseMove" MouseLeftButtonUp="PomoHeaderRow_MouseLeftButtonUp" ToolTip="Drag header to move between Bottom Right, Bottom Left, or Top Bar">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Crisp Coral Vector Stopwatch Icon -->
                            <Viewbox Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 10,2 L 14,2" Stroke="#F43F5E" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Path Data="M 12,2 L 12,5.5" Stroke="#F43F5E" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Path Data="M 17.5,6.2 L 19.3,4.4" Stroke="#F43F5E" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Ellipse Width="15.5" Height="15.5" Canvas.Left="4.25" Canvas.Top="5.5" Fill="#F43F5E"/>
                                    <Path Data="M 12,13.25 L 12,9.2" Stroke="White" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Ellipse Width="2.6" Height="2.6" Canvas.Left="10.7" Canvas.Top="11.95" Fill="White"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="TxtFloatingTimerHeader" Text="Focus Timer" FontWeight="Bold" FontSize="13.5" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                            <!-- Compact Time Badge when Minimized -->
                            <Border x:Name="PomoMinTimeChip" Visibility="Collapsed" Background="#1D2546" BorderBrush="#334175" BorderThickness="1" CornerRadius="8" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="PomoMinDot" Width="5.5" Height="5.5" Fill="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtPomoMinTime" Text="25:00" FontFamily="Consolas, Courier New" FontSize="11.5" FontWeight="Black" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right Header Controls: ONLY Settings & Drop Arrow -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnPomoSettingsToggle" Click="BtnPomoSettingsToggle_Click" Cursor="Hand" Width="28" Height="28" Margin="0,0,2,0" ToolTip="Timer Settings">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#247C5CFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Viewbox Width="14" Height="14">
                                    <Path x:Name="IconPomoGearPath" Fill="#94A3B8" Data="M19.14,12.94 C19.18,12.64 19.2,12.33 19.2,12 C19.2,11.67 19.18,11.36 19.13,11.06 L21.16,9.48 C21.34,9.34 21.39,9.07 21.28,8.87 L19.36,5.55 C19.24,5.33 18.99,5.26 18.77,5.33 L16.38,6.29 C15.88,5.91 15.35,5.59 14.76,5.35 L14.4,2.81 C14.36,2.57 14.16,2.4 13.92,2.4 L10.08,2.4 C9.84,2.4 9.65,2.57 9.61,2.81 L9.25,5.35 C8.66,5.59 8.12,5.92 7.63,6.29 L5.24,5.33 C5.02,5.25 4.77,5.33 4.65,5.55 L2.74,8.87 C2.62,9.08 2.66,9.34 2.86,9.48 L4.89,11.06 C4.84,11.36 4.8,11.69 4.8,12 C4.8,12.31 4.82,12.64 4.87,12.94 L2.84,14.52 C2.66,14.66 2.61,14.93 2.72,15.13 L4.64,18.45 C4.76,18.67 5.01,18.74 5.23,18.67 L7.62,17.71 C8.12,18.09 8.65,18.41 9.24,18.65 L9.6,21.19 C9.65,21.43 9.84,21.6 10.08,21.6 L13.92,21.6 C14.16,21.6 14.36,21.43 14.39,21.19 L14.75,18.65 C15.34,18.41 15.88,18.09 16.37,17.71 L18.76,18.67 C18.98,18.75 19.23,18.67 19.35,18.45 L21.27,15.13 C21.39,14.91 21.34,14.66 21.15,14.52 L19.14,12.94 Z M12,15.6 C10.02,15.6 8.4,13.98 8.4,12 C8.4,10.02 10.02,8.4 12,8.4 C13.98,8.4 15.6,10.02 15.6,12 C15.6,13.98 13.98,15.6 12,15.6 Z"/>
                                </Viewbox>
                            </Button>

                            <Button x:Name="BtnPomoCollapseToggle" Click="BtnPomoCollapseToggle_Click" Cursor="Hand" Width="28" Height="28" ToolTip="Minimize / Expand Timer">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#247C5CFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Viewbox Width="13" Height="13">
                                    <Path x:Name="IconPomoChevronPath" Data="M 6,9 L 12,15 L 18,9" Stroke="#94A3B8" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Upgraded Inline Timer Settings Panel -->
                    <Border x:Name="PomoSettingsPanel" Visibility="Collapsed" Background="#10152D" BorderBrush="#2A335C" BorderThickness="1" CornerRadius="16" Padding="12" Margin="0,12,0,4">
                        <StackPanel>
                            <!-- Settings Header & Quick Preset Pills -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtPomoSettingsLabel" Grid.Column="0" Text="PRESETS" FontSize="9.5" FontWeight="Black" Foreground="#8A95B7" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="BtnPomoPreset25" Click="BtnPomoQuickPreset_Click" Tag="25,5" Cursor="Hand" Margin="0,0,4,0" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="25m Focus / 5m Break">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{DynamicResource SubtleBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="7" Padding="6,2.5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#7C5CFF"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="25/5" FontSize="9.5" FontWeight="Bold"/>
                                    </Button>
                                    <Button x:Name="BtnPomoPreset50" Click="BtnPomoQuickPreset_Click" Tag="50,10" Cursor="Hand" Margin="0,0,4,0" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="50m Deep / 10m Break">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{DynamicResource SubtleBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="7" Padding="6,2.5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#7C5CFF"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="50/10" FontSize="9.5" FontWeight="Bold"/>
                                    </Button>
                                    <Button x:Name="BtnPomoPreset15" Click="BtnPomoQuickPreset_Click" Tag="15,3" Cursor="Hand" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="15m Sprint / 3m Break">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{DynamicResource SubtleBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="7" Padding="6,2.5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#7C5CFF"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="15/3" FontSize="9.5" FontWeight="Bold"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Side-by-Side Work & Break Stepper Tiles -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Focus Minutes Card -->
                                <Border x:Name="BdWorkStepperCard" Grid.Column="0" Background="#161D3D" BorderBrush="#2A3562" BorderThickness="1" CornerRadius="12" Padding="8,7">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                                            <Ellipse Width="6" Height="6" Fill="#F43F5E" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtWorkStepperLbl" Text="Focus (min)" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                        </StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="22"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Click="BtnStepWorkDown_Click" Width="22" Height="22" Cursor="Hand" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="-5 min">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="{DynamicResource SubtleBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="6">
                                                            <TextBlock Text="−" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#7C5CFF"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <TextBox x:Name="TxtPomoWorkInput" Grid.Column="1" Text="25" Background="Transparent" BorderThickness="0" Foreground="#F8FAFC" CaretBrush="#22D3EE" FontFamily="Consolas, Courier New" FontSize="14.5" FontWeight="Black" TextAlignment="Center" VerticalContentAlignment="Center"/>
                                            <Button Grid.Column="2" Click="BtnStepWorkUp_Click" Width="22" Height="22" Cursor="Hand" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="+5 min">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="{DynamicResource SubtleBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="6">
                                                            <TextBlock Text="+" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#7C5CFF"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Break Minutes Card -->
                                <Border x:Name="BdBreakStepperCard" Grid.Column="2" Background="#161D3D" BorderBrush="#2A3562" BorderThickness="1" CornerRadius="12" Padding="8,7">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                                            <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtBreakStepperLbl" Text="Break (min)" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                        </StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="22"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Click="BtnStepBreakDown_Click" Width="22" Height="22" Cursor="Hand" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="-1 min">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="{DynamicResource SubtleBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="6">
                                                            <TextBlock Text="−" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#10B981"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <TextBox x:Name="TxtPomoBreakInput" Grid.Column="1" Text="5" Background="Transparent" BorderThickness="0" Foreground="#F8FAFC" CaretBrush="#10B981" FontFamily="Consolas, Courier New" FontSize="14.5" FontWeight="Black" TextAlignment="Center" VerticalContentAlignment="Center"/>
                                            <Button Grid.Column="2" Click="BtnStepBreakUp_Click" Width="22" Height="22" Cursor="Hand" Foreground="{DynamicResource PrimaryTextBrush}" ToolTip="+1 min">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="{DynamicResource SubtleBgBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="6">
                                                            <TextBlock Text="+" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#10B981"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Timer Placement Segmented Control (Bottom Left | Top Bar | Bottom Right) -->
                            <Border x:Name="BdDockTrack" Background="#161D3D" BorderBrush="#2A3562" BorderThickness="1" CornerRadius="11" Padding="3" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnDockLeft" Grid.Column="0" Click="BtnSetDockPosition_Click" Tag="bottom-left" Cursor="Hand" ToolTip="Move timer to Bottom Left">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="4,5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="↙ Left" FontSize="10" FontWeight="Bold"/>
                                    </Button>
                                    <Button x:Name="BtnDockTop" Grid.Column="1" Click="BtnSetDockPosition_Click" Tag="top-bar" Cursor="Hand" ToolTip="Move timer to Top Bar">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="4,5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="⬆ Top Bar" FontSize="10" FontWeight="Bold"/>
                                    </Button>
                                    <Button x:Name="BtnDockRight" Grid.Column="2" Click="BtnSetDockPosition_Click" Tag="bottom-right" Cursor="Hand" ToolTip="Move timer to Bottom Right">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="4,5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
