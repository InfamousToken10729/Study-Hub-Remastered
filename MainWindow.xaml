                    <!-- Left: Back Button & Document Info -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="BtnClosePdfViewer_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" Margin="0,0,14,0" ToolTip="Back to Course (Esc)">
                            <TextBlock Text="←" FontSize="14" FontWeight="Bold"/>
