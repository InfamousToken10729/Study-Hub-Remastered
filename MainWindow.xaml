        <!-- ================= FULLSCREEN IN-APP PDF VIEWER OVERLAY ================= -->
        <Grid x:Name="PdfViewerOverlayGrid" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="320" Background="#0B0D18">
