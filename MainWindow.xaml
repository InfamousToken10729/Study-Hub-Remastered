                                <TextBlock Text="StudyHub In-App PDF Reader" FontSize="11" Foreground="#687296"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: Consistent Clock, Timer, Sound Mixer & Action Controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Live Clock Widget (Consistent Left Position!) -->
                        <Border x:Name="PdfNavClockBorder" MouseDown="NavClockBorder_MouseDown" Cursor="Hand" Background="#181D38" BorderBrush="#283056" BorderThickness="1" CornerRadius="12" Padding="12,6" Margin="0,0,10,0" ToolTip="Click to toggle 12h / 24h clock format">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🕒" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtPdfClockTime" Text="12:00:00 AM" FontWeight="Bold" FontSize="13" FontFamily="Consolas, Courier New" Foreground="#F4F6FF" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtPdfClockDate" Text="Fri, Nov 6" FontSize="11" Foreground="#9AA3C2" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Focus Timer Pill (Consistent Right Position!) -->
                        <Border x:Name="PdfNavTimerPill" MouseDown="NavTimerPill_MouseDown" Cursor="Hand" Background="#2D1B36" BorderBrush="#F43F5E" BorderThickness="1" CornerRadius="12" Padding="10,6" Margin="0,0,12,0" ToolTip="Focus Timer Controls">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 10,2 L 14,2" Stroke="#F43F5E" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Path Data="M 12,2 L 12,5" Stroke="#F43F5E" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Ellipse Width="15" Height="15" Canvas.Left="4.5" Canvas.Top="5.5" Fill="#F43F5E"/>
                                        <Path Data="M 12,13 L 15,9.5" Stroke="White" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="TxtPdfTimerDisplay" Text="25:00" FontWeight="Black" FontFamily="Consolas, Courier New" FontSize="13" Foreground="#F472B6" VerticalAlignment="Center"/>
                                <Ellipse x:Name="PdfTimerStatusDot" Width="7" Height="7" Fill="#10B981" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Sound Mixer Button in PDF Mode (User Request #5!) -->
                        <Button Click="BtnNavSoundMixer_Click" Style="{StaticResource CircularNavButtonStyle}" Margin="0,0,8,0" ToolTip="Ambient Sound Studio &amp; Mixer">
                            <TextBlock Text="🎚️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Dark Mode Toggle Button -->
                        <Button x:Name="BtnPdfToggleDarkMode" Click="BtnPdfToggleDarkMode_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="12,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Grid Width="24" Height="24">
                                        <Canvas x:Name="GridPdfSunIcon" Width="24" Height="24" Visibility="Collapsed">
                                            <Line X1="12" Y1="4.7" X2="12" Y2="1.7" Stroke="#FDE047" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Line X1="12" Y1="19.3" X2="12" Y2="22.3" Stroke="#FBBF24" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Line X1="4.7" Y1="12" X2="1.7" Y2="12" Stroke="#FDE047" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Line X1="19.3" Y1="12" X2="22.3" Y2="12" Stroke="#FBBF24" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Line X1="17.16" Y1="6.84" X2="19.14" Y2="4.86" Stroke="#FDE047" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Line X1="6.84" Y1="6.84" X2="4.86" Y2="4.86" Stroke="#FDE047" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Line X1="17.16" Y1="17.16" X2="19.14" Y2="19.14" Stroke="#FBBF24" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Line X1="6.84" Y1="17.16" X2="4.86" Y2="19.14" Stroke="#FBBF24" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Ellipse Width="10" Height="10" Canvas.Left="7" Canvas.Top="7">
                                                <Ellipse.Fill>
                                                    <RadialGradientBrush GradientOrigin="0.35,0.35">
                                                        <GradientStop Color="#FEF08A" Offset="0.0"/>
                                                        <GradientStop Color="#FACC15" Offset="0.55"/>
                                                        <GradientStop Color="#F59E0B" Offset="1.0"/>
