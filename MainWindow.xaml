                            </StackPanel>
                        </StackPanel>
                        <Button Click="BtnCloseTopBarTimerDropdown_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Width="28" Height="28" Padding="0">
                            <TextBlock Text="✕" FontSize="11" FontWeight="Bold"/>
                        </Button>
                    </Grid>

                    <!-- Countdown -->
                    <TextBlock x:Name="TxtDropdownTimerDisplay" Text="25:00" FontSize="44" FontWeight="Black" FontFamily="Consolas, Courier New" HorizontalAlignment="Center" Margin="0,2,0,12">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#60A5FA" Offset="0.0"/>
                                <GradientStop Color="#22D3EE" Offset="0.52"/>
                                <GradientStop Color="#818CF8" Offset="1.0"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>

                    <!-- Start / Pause / Reset -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Click="BtnTimerStart_Click" Cursor="Hand" Height="34" Background="#10B981" Foreground="White" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Start" FontSize="12" FontWeight="Bold"/>
                        </Button>
                        <Button Grid.Column="2" Click="BtnTimerPause_Click" Cursor="Hand" Height="34" Background="#F59E0B" Foreground="White" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Pause" FontSize="12" FontWeight="Bold"/>
                        </Button>
                        <Button Grid.Column="4" Click="BtnTimerReset_Click" Style="{StaticResource SecondaryButtonStyle}" Height="34" Padding="0" ToolTip="Reset Timer">
                            <Viewbox Width="13.5" Height="13.5">
                                <Path Fill="{DynamicResource PrimaryTextBrush}" Data="M17.65,6.35 C16.2,4.9 14.21,4 12,4 C7.58,4 4.01,7.58 4.01,12 C4.01,16.42 7.58,20 12,20 C15.73,20 18.84,17.45 19.73,14 L17.65,14 C16.83,16.33 14.61,18 12,18 C8.69,18 6,15.31 6,12 C6,8.69 8.69,6 12,6 C13.66,6 15.14,6.69 16.22,7.78 L13,11 L20,11 L20,4 L17.65,6.35 Z"/>
                            </Viewbox>
                        </Button>
                    </Grid>

                    <!-- Quick Durations -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Click="BtnDropdownWorkPreset_Click" Tag="25" Style="{StaticResource SecondaryButtonStyle}" Padding="0,5">
                            <TextBlock Text="25m" FontSize="11" FontWeight="Bold"/>
                        </Button>
                        <Button Grid.Column="2" Click="BtnDropdownWorkPreset_Click" Tag="50" Style="{StaticResource SecondaryButtonStyle}" Padding="0,5">
                            <TextBlock Text="50m" FontSize="11" FontWeight="Bold"/>
                        </Button>
                        <Button Grid.Column="4" Click="BtnDropdownWorkPreset_Click" Tag="15" Style="{StaticResource SecondaryButtonStyle}" Padding="0,5">
                            <TextBlock Text="15m" FontSize="11" FontWeight="Bold"/>
                        </Button>
                        <Button Grid.Column="6" Click="BtnPresetBreak5_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="0,5">
                            <TextBlock Text="5m ☕" FontSize="10.5" FontWeight="Bold"/>
                        </Button>
                    </Grid>

                    <!-- Move Timer Position Actions -->
                    <TextBlock Text="MOVE TIMER POSITION" FontSize="9.5" FontWeight="Black" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnDropdownDockLeft" Grid.Column="0" Click="BtnSetDockPosition_Click" Tag="bottom-left" Style="{StaticResource SecondaryButtonStyle}" Padding="4,7">
