                            <TextBlock Text="📄" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtPdfViewerTitle" Text="Document.pdf" FontWeight="Black" FontSize="14" Foreground="#F4F6FF" MaxWidth="380" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock x:Name="TxtPdfViewerSubject" Text="Avionics" FontSize="11" FontWeight="Bold" Foreground="#8A95B7"/>
