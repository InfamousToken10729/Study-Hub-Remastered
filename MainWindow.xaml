                    <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="10" Opacity="0.42"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Dropdown Header -->
                    <Grid Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 10,2 L 14,2" Stroke="#F43F5E" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Path Data="M 12,2 L 12,5.5" Stroke="#F43F5E" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Ellipse Width="15.5" Height="15.5" Canvas.Left="4.25" Canvas.Top="5.5" Fill="#F43F5E"/>
                                    <Path Data="M 12,13.25 L 12,9.2" Stroke="White" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                            <StackPanel>
                                <TextBlock x:Name="TxtDropdownHeader" Text="Focus Timer" FontSize="13.5" FontWeight="Bold" Foreground="#F8FAFC"/>
